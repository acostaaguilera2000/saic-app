extends ../layout
block styles
    link(rel="stylesheet" href="/css/tablas-institucionales.css")
block content

    //- Encabezado de Página Institucional (Estructura balanceada y ordenada)
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4
        div
            h2.fw-bold.text-dark.mb-1 Programación de Cultos
            p.text-muted.small.mb-0 Cronograma de servicios, horarios y asignaciones ministeriales.

        //- Contenedor de Acciones Unificado
        .d-flex.flex-wrap.align-items-center.gap-2
            a.btn.btn-outline-danger.shadow-sm.px-3.py-2.fw-semibold(href="/cultos/reporte")
                i.bi.bi-file-earmark-text.me-2
                | Vista Reporte

            a.btn.btn-action.shadow-sm.px-4.py-2.fw-semibold(href="/cultos/create")
                i.bi.bi-calendar-plus.me-2
                | Nuevo Culto

    //- Contenedor Principal (Tabla optimizada estéticamente y para DataTables)
    .card.card-custom.border-0.shadow-sm.overflow-hidden
        .card-body.p-3
            .table-responsive
                table.table.table-hover.align-middle.mb-0.tabla-institucional#tabla-cronograma-cultos
                    thead
                        tr
                            th.ps-4.py-3(style="width: 80px;") ID
                            th.py-3 FECHA Y HORA
                            th.py-3 TIPO DE CULTO
                            th.py-3 DIRIGENTE
                            th.py-3 PREDICADOR
                            th.pe-4.py-3.text-end ACCIONES

                    tbody
                        if cultos && cultos.length > 0
                            each culto in cultos
                                tr
                                    td.ps-4
                                        span.id-badge ##{culto.id_culto}

                                    td
                                        - var f = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'short'}) : 'No asignada' 
                                        span.text-uppercase.d-block.fw-bold.txt-carmesi #{f}
                                        if culto.hora
                                            - var [horas, minutos] = culto.hora.split(':')
                                            - var fechaBase = new Date(2000, 0, 1, horas, minutos)
                                            - var horaFormateada = fechaBase.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true })
                                            span.text-muted.small.fw-semibold #{horaFormateada}
                                        else
                                            span.text-muted.small.fw-semibold Por definir

                                    td
                                        span.badge.badge-culto-tipo.text-uppercase.fw-bold #{culto.tipo_culto}

                                    td
                                        if culto.id_dirigente
                                            span.small.text-dark.fw-medium
                                                i.bi.bi-person-check.text-primary.me-1
                                                | #{culto.nombre_dirigente} #{culto.apellido_dirigente}
                                        else if culto.dirigente_externo
                                            span.small.text-warning.fw-semibold
                                                i.bi.bi-person-dash.me-1
                                                | #{culto.dirigente_externo} (Invitado)
                                        else
                                            span.small.text-muted.fst-italic Sin asignar

                                    td
                                        if culto.id_predicador
                                            span.small.text-dark.fw-medium
                                                i.bi.bi-megaphone.text-success.me-1
                                                | #{culto.nombre_predicador} #{culto.apellido_predicador}
                                        else if culto.predicador_externo
                                            span.small.text-warning.fw-semibold
                                                i.bi.bi-person-dash.me-1
                                                | #{culto.predicador_externo} (Invitado)
                                        else
                                            span.small.text-muted.fst-italic Sin asignar

                                    td.pe-4.text-end
                                        .d-flex.justify-content-end.gap-2
                                            a.btn.btn-sm.btn-accion-logistica.rounded-3(href=`/logistica/manage/${culto.id_culto}` title="Gestionar Logística")
                                                i.bi.bi-gear-fill
                                            a.btn.btn-sm.btn-accion-editar.rounded-3(href=`/cultos/update/${culto.id_culto}` title="Editar Culto")
                                                i.bi.bi-pencil-square
                                            button.btn.btn-sm.btn-accion-eliminar.rounded-3(
                                                type="button" 
                                                title="Eliminar Culto"
                                                onclick=`confirmarEliminacion('${culto.id_culto}', '${culto.tipo_culto}')`
                                            )
                                                i.bi.bi-trash
                        else
                            tr
                                td.text-center.py-5.text-muted(colspan="6") 
                                    i.bi.bi-calendar-x.d-block.fs-2.mb-2.text-black-50
                                    | No hay reuniones agendadas en este momento.

block scripts

    script.
        window.addEventListener('load', function() {
            if (typeof jQuery !== 'undefined') {
                $('#tabla-cronograma-cultos').DataTable({
                    pageLength: 10,
                    lengthMenu: [5, 10, 25, 50],
                    order: [[1, 'desc']],
                    // 🔥 SOLUCIÓN AL ALINEAMIENTO: Forzamos el DOM usando flexbox nativo de Bootstrap 5
                    dom: "<'row mb-3 align-items-center'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6 d-flex justify-content-md-end'f>>" +
                        "<'row'<'col-sm-12'tr>>" +
                        "<'row mt-3 align-items-center'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7 d-flex justify-content-md-end'p>>",
                    language: {
                        processing: "Procesando...",
                        search: "Buscar servicios:",
                        lengthMenu: "Mostrar _MENU_ registros",
                        info: "Mostrando del registro _START_ al _END_ de un total de _TOTAL_ cultos",
                        infoEmpty: "Mostrando 0 registros de 0",
                        infoFiltered: "(filtrado de un total de _MAX_ registros)",
                        loadingRecords: "Cargando cronograma...",
                        zeroRecords: "No se encontraron cultos que coincidan con la búsqueda",
                        emptyTable: "No hay reuniones agendadas en este momento",
                        paginate: {
                            first: "«",
                            previous: "‹",
                            next: "›",
                            last: "»"
                        }
                    },
                    columnDefs: [
                        {
                            targets: -1,
                            orderable: false,
                            searchable: false
                        }
                    ]
                });
            } else {
                console.error("SAIC Error: jQuery no se cargó a tiempo en el navegador.");
            }
        });

        window.confirmarEliminacion = function(id, tipo) {
            if (confirm(`¿Estás seguro de que deseas eliminar la programación del Culto de tipo "${tipo}"?\nEsta acción no se puede deshacer.`)) {
                window.location.href = `/cultos/delete/${id}`;
            }
        };