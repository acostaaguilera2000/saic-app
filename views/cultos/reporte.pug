extends ../layout

block content
    //- Panel de Control Web (Se oculta por completo en el PDF/Impresión)
    .d-flex.justify-content-between.align-items-center.mb-4.d-print-none
        div
            h3.fw-bold.text-dark.mb-1 Cronograma Oficial de Servicios
            p.text-muted.small Vista de impresión y distribución en formato PDF institucional.
        .d-flex.gap-2
            button.btn.btn-danger.px-4(type="button" onclick="window.print()")
                i.bi.bi-file-earmark-pdf-fill.me-2
                | Imprimir / Guardar como PDF
            a.btn.btn-light.border.px-3(href="/cultos") Volver

    //- Filtro de Meses Institucional (Se oculta por completo en el PDF/Impresión)
    .card.border-0.shadow-sm.mb-4.d-print-none
        .card-body.p-3.bg-light
            .row.align-items-center
                .col-md-3
                    label.form-label.fw-bold.text-dark.mb-md-0(for="filtro-mes")
                        i.bi.bi-filter-left.me-2(style="color: var(--ijersac-navy);")
                        | Filtrar por Mes:
                .col-md-4
                    select#filtro-mes.form-select
                        option(value="") -- Mostrar todos los meses --
                        option(value="ene") Enero
                        option(value="feb") Febrero
                        option(value="mar") Marzo
                        option(value="abr") Abril
                        option(value="may") Mayo
                        option(value="jun") Junio
                        option(value="jul") Julio
                        option(value="ago") Agosto
                        option(value="sep") Septiembre
                        option(value="oct") Octubre
                        option(value="nov") Noviembre
                        option(value="dic") Diciembre

    //- Contenedor del Reporte (Optimizado para Hojas de Tamaño Carta / A4)
    .card.border-0.shadow-sm.card-reporte
        .card-body.p-4.p-md-5

            //- Encabezado Institucional (Visible en Web y PDF)
            .text-center.mb-4.encabezado-reporte
                h2.fw-bold.mb-1.titulo-iglesia(style="color: var(--ijersac-navy);") IGLESIA JESUS DE NAZARET
                h6.fw-semibold.text-muted.letter-spacing-1 AGENDA GENERAL DE SERVICIOS Y LOGÍSTICA OPERATIVA
                .text-end.text-muted.small.mt-2(style="font-size: 11px;") Fecha de emisión: #{new Date().toLocaleDateString('es-ES')}
                .linea-separadora.mt-2

            //- Tabla Principal Estilizada con Variables CSS Reales
            .table-responsive
                table.table.table-bordered.align-middle.tabla-institucional
                    thead
                        tr
                            th(style="width: 20%;") Fecha y Hora
                            th(style="width: 20%;") Tipo de Servicio
                            th(style="width: 30%;") Altar y Ministerio
                            th(style="width: 30%;") Soporte y Logística
                    tbody
                        if cronograma && cronograma.length > 0
                            each item in cronograma
                                tr
                                    //- Generamos el mes crudo (limpio, sin puntos) para el filtro lógico de DataTables
                                    - var mesCrudo = item.fecha ? new Date(item.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', month: 'short'}).toLowerCase().replace('.', '') : '' 
                                    td.celda-fecha(data-filter=mesCrudo)
                                        - var f = item.fecha ? new Date(item.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'short'}) : 'No asignada' 
                                        span.text-uppercase.d-block.fw-bold.txt-carmesi #{f}
                                        if item.hora
                                            - var [horas, minutos] = item.hora.split(':')
                                            - var fechaBase = new Date(2000, 0, 1, horas, minutos)
                                            - var horaFormateada = fechaBase.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true })
                                            span.text-muted.small.fw-semibold #{horaFormateada}
                                        else
                                            span.text-muted.small.fw-semibold Por definir

                                    //- Columna: Tipo de Culto
                                    td
                                        span.badge-servicio.fw-bold.text-uppercase #{item.tipo_culto}

                                    //- Columna: Altar (Locales y externos corregidos)
                                    td.celda-datos
                                        div
                                            span.subtitulo-rol.fw-bold Dirección: 
                                            span.texto-assigned
                                                if item.dir_nom
                                                    | #{item.dir_nom} #{item.dir_ape}
                                                else if item.dirigente_externo && item.dirigente_externo.trim() !== ""
                                                    | #{item.dirigente_externo}
                                                else
                                                    span.text-muted.fst-italic Por asignar
                                        div.mt-2
                                            span.subtitulo-rol.fw-bold Predicación: 
                                            span.texto-assigned
                                                if item.pred_nom
                                                    | #{item.pred_nom} #{item.pred_ape}
                                                else if item.predicador_externo && item.predicador_externo.trim() !== ""
                                                    | #{item.predicador_externo}
                                                else
                                                    span.text-muted.fst-italic Por asignar

                                    //- Columna: Soporte y Logística
                                    td.celda-datos
                                        if item.son_nom
                                            div
                                                span.subtitulo-rol Sonido: 
                                                span.texto-assigned #{item.son_nom} #{item.son_ape}

                                        if item.mul_nom
                                            div.mt-1
                                                span.subtitulo-rol Multimedia: 
                                                span.texto-assigned #{item.mul_nom} #{item.mul_ape}

                                        div.mt-1
                                            span.subtitulo-rol Aseo: 
                                            span.texto-assigned
                                                if item.ase_nom
                                                    | #{item.ase_nom} #{item.ase_ape}
                                                else
                                                    span.text-muted.fst-italic Por asignar

                                        .notas-logistica.mt-2.pt-1
                                            strong Observaciones: 
                                            if item.observaciones && item.observaciones.trim() !== ""
                                                span.text-dark #{item.observaciones}
                                            else
                                                span.text-muted.fst-italic Ninguna
                        else
                            tr
                                td.text-center.py-5.text-muted(colspan="4")
                                    | No se encuentran programaciones registradas para las próximas fechas.

            //- Pie de Página / Versículo de Cierre
            .footer-reporte.text-center.mt-5
                p.mb-1.fst-italic "Todo lo que hagáis, hacedlo de corazón, como para el Señor y no para los hombres." — Colosenses 3:23
                p.mb-0.text-uppercase.fw-bold.x-small SAIC — Sistema de Administración de Iglesias Cristianas

block scripts
    style.
        /* Estilos Exclusivos para la Vista de Reporte en Pantalla */
        .letter-spacing-1 { letter-spacing: 1px; }
        .linea-separadora { height: 3px; background-color: var(--ijersac-navy); width: 100%; }
        .txt-carmesi { color: var(--ijersac-red); }

        .tabla-institucional {
            border: 1px solid var(--gris-borde, #dce1e7) !important;
        }
        .tabla-institucional thead th {
            background-color: var(--ijersac-navy) !important;
            color: #ffffff !important;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            padding: 12px !important;
            border: 1px solid var(--ijersac-navy);
        }

        .badge-servicio {
            color: var(--ijersac-navy);
            display: inline-block;
            padding: 5px 10px;
            font-size: 11px;
        }

        .celda-fecha { font-size: 13px; }
        .subtitulo-rol { font-weight: 600; color: #555; font-size: 12px; }
        .texto-assigned { color: #222; font-size: 12px; }
        .notas-logistica { font-size: 11px; border-top: 1px dashed #dce1e7; }

        /* 🖨️ Reglas de CSS para Impresión Física y PDF */
        @media print {
            .d-print-none, nav, aside, .sidebar, header, .top-header, footer, .btn {
                display: none !important;
            }

            .dt-container {
                display: block !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            body {
                background-color: #ffffff !important;
                color: #000000 !important;
                font-size: 11px;
                margin: 0;
                padding: 0;
            }
            .main-wrapper, .content-body, .container-fluid {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
            }
            .card-reporte {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                background: transparent !important;
            }
            .table-responsive {
                overflow: visible !important;
            }
            .tabla-institucional {
                width: 100% !important;
                border-collapse: collapse !important;
            }
            .tabla-institucional thead th {
                background-color: var(--ijersac-navy) !important;
                color: #ffffff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .badge-servicio {
                background-color: #f0f4f8 !important;
                color: var(--ijersac-navy) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .txt-carmesi {
                color: var(--ijersac-red) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }

    //- Inyección del Script dinámico desde la carpeta modules
    script(src="/js/modules/reporte-filtro.js")