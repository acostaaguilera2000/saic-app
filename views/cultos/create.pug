extends ../layout

block content
  .row.justify-content-center
    .col-12
      .d-flex.justify-content-between.align-items-center.mb-3
        div
          h3.fw-bold.text-dark.mb-1 Programación Masiva de Cultos
          p.text-muted.small Añada múltiples filas para planificar de forma ágil la agenda litúrgica de la iglesia.
        a.btn.btn-sm.btn-light.border.px-3(href="/cultos")
          i.bi.bi-arrow-left.me-1
          | Volver


      form(action="/cultos/create" method="POST")
        .card.card-custom.border-0.shadow-sm.mb-4
          .card-body.p-4
            .table-responsive
              table.table.align-middle.table-bordered.tabla-institucional#tabla-cultos
                thead.table-light
                  tr
                    th(style="width: 15%;") Fecha
                    th(style="width: 12%;") Hora
                    th(style="width: 20%;") Tipo de Culto
                    th(style="width: 24%;") Dirección (Altar)
                    th(style="width: 24%;") Predicación
                    th.text-center(style="width: 5%;")
                tbody
                  tr.fila-culto
                    td
                      input.form-control(type="date" name="cultos[0][fecha]" required)
                    td
                      input.form-control(type="time" name="cultos[0][hora]" required)
                    td
                      select.form-select(name="cultos[0][tipo_culto]" required)
                        option(value="" disabled selected) Seleccione...
                        option(value="Culto General") Culto General
                        option(value="Culto de Jóvenes") Culto de Jóvenes
                        option(value="Culto de Damas") Culto de Damas
                        option(value="Culto de Caballeros") Culto de Caballeros
                        option(value="Escuela Bíblica Dominical") Escuela Bíblica Dominical
                        option(value="Culto de Oración") Culto de Oración
                    td
                      select.form-select.mb-1(name="cultos[0][id_dirigente]")
                        option(value="") -- Miembro Local --
                        if miembros && miembros.length
                          each m in miembros
                            option(value=m.id_miembro)= `${m.nombre} ${m.apellido}`
                      input.form-control.form-control-sm(type="text" name="cultos[0][dirigente_externo]" placeholder="O Invitado Externo")
                    td
                      select.form-select.mb-1(name="cultos[0][id_predicador]")
                        option(value="") -- Miembro Local --
                        if miembros && miembros.length
                          each m in miembros
                            option(value=m.id_miembro)= `${m.nombre} ${m.apellido}`
                      input.form-control.form-control-sm(type="text" name="cultos[0][predicador_externo]" placeholder="O Invitado Externo")
                    td.text-center
                      button.btn.btn-sm.btn-outline-danger.btn-eliminar-fila(type="button" disabled)
                        i.bi.bi-x-lg

            .d-flex.justify-content-start.mt-3
              button.btn.btn-light.btn-sm.rounded-pill#btn-agregar-fila(type="button")
                i.bi.bi-plus-circle.me-2
                | Añadir otra fila al cronograma

        .d-flex.justify-content-end.gap-3
          a.btn.btn-light.px-4(href="/cultos") Cancelar
          button.btn.btn-primary.px-5(type="submit")
            i.bi.bi-save.me-2
            | Guardar Programación Masiva

block scripts
  script.
    document.addEventListener("DOMContentLoaded", () => {
      const tabla = document.getElementById("tabla-cultos").getElementsByTagName("tbody")[0];
      const btnAgregar = document.getElementById("btn-agregar-fila");
      let contadorFilas = 1;

      btnAgregar.addEventListener("click", () => {
        // Clonar la primera fila de manera profunda
        const nuevaFila = tabla.rows[0].cloneNode(true);
        
        // Corregir y limpiar los elementos internos individualmente
        Array.from(nuevaFila.querySelectorAll("input, select")).forEach((element) => {
          element.value = ""; // Limpia el valor escrito o seleccionado
          
          // Si es un selector, removemos manualmente cualquier persistencia del select anterior
          if (element.tagName === "SELECT") {
            element.selectedIndex = 0;
          }
          
          const nameAttr = element.getAttribute("name");
          if (nameAttr) {
            const nuevoName = nameAttr.replace(/\[\d+\]/, `[${contadorFilas}]`);
            element.setAttribute("name", nuevoName);
          }
        });

        // Habilitar y configurar el botón eliminar en la nueva fila
        const btnEliminar = nuevaFila.querySelector(".btn-eliminar-fila");
        btnEliminar.removeAttribute("disabled");
        btnEliminar.addEventListener("click", () => {
          nuevaFila.remove();
        });

        tabla.appendChild(nuevaFila);
        contadorFilas++;
      });
    });