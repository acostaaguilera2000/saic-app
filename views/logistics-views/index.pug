extends ../layout

block styles
    link(rel="stylesheet" href="/css/tablas-institucionales.css")
    style.
        /* --- DISEÑO DE MATRIZ DE CALENDARIO (SAIC BENTO LOGISTICS) --- */
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 12px;
        }

        .calendar-day-btn {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            min-height: 125px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 12px;
            position: relative;
        }

        .calendar-day-btn:hover {
            border-color: var(--calm-green-primary) !important;
            transform: translateY(-3px);
            box-shadow: var(--shadow-bento) !important;
        }

        /* Indicador visual de logística asignada */
        .logistica-indicator {
            width: 6px;
            height: 6px;
            background-color: var(--calm-green-primary);
            border-radius: 50%;
            position: absolute;
            bottom: 10px;
        }

        .x-small-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-muted, #64748b);
        }

        .month-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--calm-green-primary);
            letter-spacing: 0.5px;
        }

block content
    .container-fluid.px-3.px-md-4.py-4

        //- Encabezado Estilo Banner Superior Bento Box
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4.p-4.rounded-4(style="background: var(--bg-surface); box-shadow: var(--shadow-bento);")
            div
                h2.fw-bold.text-dark.mb-1 Control de Soporte y Logística
                p.text-muted.small.mb-0 Consulta las asignaciones de Sonido, Multimedia y Aseo para cada servicio programado.

        if cultos && cultos.length > 0
            //- BARRA DE FILTRADO POR MES
            .card.border-0.mb-4.p-3(style="border-radius: 14px; background: var(--bg-surface); box-shadow: var(--shadow-bento);")
                .row.g-3.align-items-center
                    .col-12.col-md-6
                        label.form-label.small.fw-bold.text-muted(for="filter-month-select")
                            i.bi.bi-calendar-range.me-1(style="color: var(--calm-green-primary);")
                            | Filtrar por Mes:
                        select#filter-month-select.form-select.form-select-sm.rounded-3(style="border-color: var(--border-subtle);")
                            option(value="todos" selected) --- Ver Todos los Servicios ---
                            option(value="0") Enero
                            option(value="1") Febrero
                            option(value="2") Marzo
                            option(value="3") Abril
                            option(value="4") Mayo
                            option(value="5") Junio
                            option(value="6") Julio
                            option(value="7") Agosto
                            option(value="8") Septiembre
                            option(value="9") Octubre
                            option(value="10") Noviembre
                            option(value="11") Diciembre

                    .col-12.col-md-6.text-md-end.mt-md-4
                        span#counter-badge.badge.bg-light.text-dark.border.p-2.rounded-3(style="border-color: var(--border-subtle) !important;")
                            i.bi.bi-info-circle.me-1(style="color: var(--calm-green-primary);")
                            span#total-services-count.fw-bold.me-1 #{cultos.length}
                            | servicios logísticos

            //- CUADRÍCULA DE CALENDARIO ESTILO BENTO
            .calendar-grid
                each culto in cultos
                    - var mesNumero = culto.fecha ? new Date(culto.fecha).getUTCMonth() : ''
                    - var diaNumero = culto.fecha ? new Date(culto.fecha).getUTCDate() : ''
                    - var diaNombre = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'short'}) : '' 
                    - var mesNombre = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', month: 'short'}) : '' 

                    button.calendar-day-btn.btn.service-row-item(
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target=`#modal-logistica-${culto.id_culto}`
                        data-month=mesNumero
                    )
                        span.text-uppercase.fw-bold.text-muted.small.mb-0 #{diaNombre}
                        span.text-uppercase.month-label.mb-1 #{mesNombre.replace('.', '')}
                        span.display-6.text-dark.m-0.lh-1.fw-bold #{diaNumero}
                        span.logistica-indicator

            //- RENDERIZACIÓN DINÁMICA DE MODALES DE LOGÍSTICA
            each culto in cultos
                .modal.fade(
                    id=`modal-logistica-${culto.id_culto}`
                    tabindex="-1"
                    aria-labelledby=`label-${culto.id_culto}`
                    aria-hidden="true"
                )
                    .modal-dialog.modal-dialog-centered
                        .modal-content.border-0.shadow(style="border-radius: 20px; background: var(--bg-surface);")

                            //- Cabecera del Modal
                            .modal-header.border-0.pb-0.pt-4.px-4
                                div
                                    span.badge.text-dark.border.text-uppercase.fw-bold.mb-2(style="background-color: var(--bg-app); border-color: var(--border-subtle) !important;") #{culto.tipo_culto}
                                    h5.modal-title.fw-bold.text-dark(id=`label-${culto.id_culto}`) Personal de Soporte
                                button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

                            //- Cuerpo del Modal con enfoque en Operación
                            .modal-body.p-4
                                .d-flex.flex-column.gap-3

                                    //- Fila: Fecha y Hora
                                    .d-flex.align-items-center.gap-3.p-3.rounded-3(style="background-color: var(--bg-app);")
                                        i.bi.bi-clock-history.fs-4(style="color: var(--calm-green-primary);")
                                        div
                                            span.d-block.x-small-label Horario del Servicio
                                            - var fLong = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long'}) : 'No asignada' 
                                            span.small.text-dark.fw-bold.text-capitalize #{fLong}
                                            if culto.hora
                                                - var [horas, minutos] = culto.hora.split(':')
                                                - var fechaBase = new Date(2000, 0, 1, horas, minutos)
                                                - var horaFormateada = fechaBase.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true })
                                                span.text-muted.small.d-block.mt-1 
                                                    | #{horaFormateada}

                                    //- Fila: Sonido
                                    .d-flex.align-items-center.gap-3.p-3.rounded-3(style="background-color: var(--bg-app);")
                                        i.bi.bi-boombox.fs-4.text-secondary
                                        div
                                            span.d-block.x-small-label Operador de Sonido
                                            if culto.son_nom
                                                span.small.text-dark.fw-bold #{culto.son_nom} #{culto.son_ape || ''}
                                            else
                                                span.small.text-muted.fst-italic Sin asignar / Libre

                                    //- Fila: Multimedia
                                    .d-flex.align-items-center.gap-3.p-3.rounded-3(style="background-color: var(--bg-app);")
                                        i.bi.bi-pc-display.fs-4.text-secondary
                                        div
                                            span.d-block.x-small-label Proyección y Multimedia
                                            if culto.mul_nom
                                                span.small.text-dark.fw-bold #{culto.mul_nom} #{culto.mul_ape || ''}
                                            else
                                                span.small.text-muted.fst-italic Sin asignar / Libre

                                    //- Fila: Aseo
                                    .d-flex.align-items-center.gap-3.p-3.rounded-3(style="background-color: var(--bg-app);")
                                        i.bi.bi-bucket.fs-4.text-secondary
                                        div
                                            span.d-block.x-small-label Líder de Aseo
                                            if culto.ase_nom
                                                span.small.text-dark.fw-bold #{culto.ase_nom} #{culto.ase_ape || ''}
                                            else
                                                span.small.text-muted.fst-italic Sin asignar / Libre

                                    //- Fila: Observaciones Especiales
                                    if culto.observaciones && culto.observaciones.trim() !== ""
                                        .p-3.rounded-3(style="background-color: var(--calm-green-subtle); border: 1px dashed var(--border-subtle);")
                                            span.d-block.x-small-label.mb-1(style="color: var(--calm-green-primary);") Observaciones Logísticas
                                            p.small.text-dark.mb-0.lh-sm #{culto.observaciones}

                            //- Pie del Modal (Botonera integrada a SAIC)
                            .modal-footer.border-0.pt-0.pb-4.px-4
                                button.btn.btn-premium.w-100(type="button" data-bs-dismiss="modal") Entendido

        else
            .card.border-0.text-center.py-5.px-4(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento);")
                .card-body
                    i.bi.bi-calendar-x.d-block.fs-1.mb-3.text-muted
                    h5.fw-bold.text-dark No hay soporte programado
                    p.text-muted.small.mb-0 No se registran asignaciones logísticas activas en este momento.

block scripts
    script(src="/js/modules/cronograma.js")

