extends ../layout

block content
    .row.justify-content-center
        .col-lg-10
            .d-flex.justify-content-between.align-items-center.mb-3
                div
                    h3.fw-bold.text-dark.mb-1 Logística del Servicio
                    p.text-muted.small Asignación de responsabilidades técnicas, operativas y de aseo.
                a.btn.btn-sm.btn-light.border.px-3(href="/service")
                    i.bi.bi-arrow-left.me-1
                    | Volver

            if errores && errores.length > 0
                .alert.alert-danger.border-0.shadow-sm.mb-4
                    h6.fw-bold.mb-2 Error en la asignación:
                    ul.mb-0.ps-3.small
                        each err in errores
                            li #{err}

            //- Información de Referencia del Culto (Tarjeta Visual)
            .card.bg-light.border-0.shadow-sm.mb-4
                .card-body.p-3
                    .row.align-items-center.text-center.text-md-start
                        .col-md-4.border-end-md
                            span.x-small.text-uppercase.text-muted.fw-bold Servicio seleccionado
                            h5.fw-bold.text-primary.mb-0 #{culto.tipo_culto}
                        .col-md-4.border-end-md
                            span.x-small.text-uppercase.text-muted.fw-bold Fecha y Hora
                            p.small.mb-0.text-dark.fw-semibold
                                i.bi.bi-calendar3.me-2
                                - var fCulto = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC'}) : 'No asignada' 
                                | #{fCulto} — #{culto.hora ? culto.hora.substring(0, 5) : 'Por definir'}
                        .col-md-4
                            span.x-small.text-uppercase.text-muted.fw-bold Altar (Predicador)
                            p.small.mb-0.text-dark
                                i.bi.bi-megaphone.me-2
                                | #{culto.id_predicador ? `${culto.nombre_predicador} ${culto.apellido_predicador}` : (culto.predicador_externo || 'Por asignar')}

            //- Formulario de Gestión Logística
            .card.card-custom.border-0.shadow-sm
                .card-body.p-4
                    form(action=`/logistic/manage/${culto.id_culto}` method="POST")
                        .row.g-4
                            //- Sección Soporte Técnico
                            .col-md-6
                                label.form-label.fw-semibold(for="id_sonido")
                                    i.bi.bi-sliders.text-primary.me-2
                                    | Ingeniería de Sonido
                                select#id_sonido.form-select(name="id_sonido")
                                    option(value="") -- Sin asignar --
                                    if miembros && miembros.length
                                        each m in miembros
                                            option(value=m.id_miembro selected=(logistica.id_sonido == m.id_miembro))= `${m.nombre} ${m.apellido}`

                            .col-md-6
                                label.form-label.fw-semibold(for="id_multimedia")
                                    i.bi.bi-pc-display-horizontal.text-primary.me-2
                                    | Multimedia y Proyección
                                select#id_multimedia.form-select(name="id_multimedia")
                                    option(value="") -- Sin asignar --
                                    if miembros && miembros.length
                                        each m in miembros
                                            option(value=m.id_miembro selected=(logistica.id_multimedia == m.id_miembro))= `${m.nombre} ${m.apellido}`

                            //- Sección Logística Operativa
                            .col-md-6
                                label.form-label.fw-semibold(for="id_aseo")
                                    i.bi.bi-sparkles.text-success.me-2
                                    | Responsable de Aseo / Ornato
                                select#id_aseo.form-select(name="id_aseo")
                                    option(value="") -- Sin asignar --
                                    if miembros && miembros.length
                                        each m in miembros
                                            option(value=m.id_miembro selected=(logistica.id_aseo == m.id_miembro))= `${m.nombre} ${m.apellido}`

                            //- Observaciones Especiales
                            .col-12
                                label.form-label.fw-semibold(for="observaciones") Observaciones / Requerimientos Especiales
                                textarea#observaciones.form-control(name="observaciones" rows="4" placeholder="Ej: Se requiere micrófono extra para instrumento, el predicador traerá diapositivas, coordinar apertura de puertas más temprano, etc.") #{logistica.observaciones || ''}

                        .d-flex.justify-content-end.gap-3.mt-4
                            a.btn.btn-light.px-4(href="/service") Cancelar
                            button.btn.btn-action.px-5(type="submit")
                                i.bi.bi-check-all.me-2
                                | Guardar Logística