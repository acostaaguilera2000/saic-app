extends ../layout

block content
    .container-fluid.px-4.py-4

        //- Encabezado institucional global con migajas de pan integradas
        +formHeader(
            `Logística del Servicio #${culto.id_culto}`, 
            '/service', 
            [
                { text: 'SAIC', link: '/dashboard', active: false },
                { text: 'Cultos', link: '/service', active: false },
                { text: 'Gestión Logística', active: true }
            ]
        )

        .row.justify-content-center
            .col-12.col-lg-10

                //- Gestión de Mensajes y Alertas Globales de SAIC
                include ../partials/_messages

                //- Información de Referencia del Culto (Tarjeta Visual Bento)
                .card.border-0.shadow-sm.mb-4(style="background: #ffffff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.02);")
                    .card-body.p-4
                        .row.g-3.align-items-center.text-center.text-md-start
                            .col-md-4.border-end-md(style="border-color: #f1f5f9 !important;")
                                span.x-small.text-uppercase.text-muted.fw-bold.d-block.mb-1 Servicio seleccionado
                                h5.fw-bold.mb-0(style="color: var(--ijersac-navy);") #{culto.tipo_culto}

                            .col-md-4.border-end-md(style="border-color: #f1f5f9 !important;")
                                span.x-small.text-uppercase.text-muted.fw-bold.d-block.mb-1 Fecha y Hora
                                p.small.mb-0.text-dark.fw-semibold
                                    i.bi.bi-calendar3.me-2.text-danger
                                    - var fCulto = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short'}) : 'No asignada' 
                                    | #{fCulto} — #{culto.hora ? culto.hora.substring(0, 5) : 'Por definir'}

                            .col-md-4
                                span.x-small.text-uppercase.text-muted.fw-bold.d-block.mb-1 Altar (Predicación)
                                p.small.mb-0.text-dark.fw-semibold
                                    i.bi.bi-megaphone.me-2.text-primary
                                    | #{culto.id_predicador ? `${culto.nombre_predicador} ${culto.apellido_predicador}` : (culto.predicador_externo || 'Por asignar')}

                //- Formulario de Gestión Logística (Caja Bento Principal)
                .card.bento-card.border-0.shadow-sm(style="background: #ffffff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.03);")
                    .card-body.p-4

                        // Subcabecera descriptiva interna
                        .d-flex.align-items-center.mb-4.p-2.rounded-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);")
                            i.bi.bi-sliders2-vertical.fs-5.me-2
                            span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Asignación de Roles Operativos y Técnicos

                        form(action=`/logistic/manage/${culto.id_culto}` method="POST")
                            .row.g-4

                                //- Sección: Soporte Técnico (Sonido)
                                .col-md-6
                                    label.form-label.fw-semibold.text-secondary(for="id_sonido")
                                        i.bi.bi-sliders.text-primary.me-2
                                        | Ingeniería de Sonido
                                    .input-group
                                        span.input-group-text.border-end-0(style="background-color: var(--ijersac-bg);"): i.bi.bi-person-badge.text-muted
                                        select#id_sonido.form-select.border-start-0.rounded-end-3(name="id_sonido")
                                            option(value="") -- Sin asignar --
                                            if miembros && miembros.length
                                                each m in miembros
                                                    option(value=m.id_miembro selected=(logistica.id_sonido == m.id_miembro))= `${m.nombre} ${m.apellido}`

                                //- Sección: Soporte Técnico (Multimedia)
                                .col-md-6
                                    label.form-label.fw-semibold.text-secondary(for="id_multimedia")
                                        i.bi.bi-pc-display-horizontal.text-primary.me-2
                                        | Multimedia y Proyección
                                    .input-group
                                        span.input-group-text.border-end-0(style="background-color: var(--ijersac-bg);"): i.bi.bi-person-badge.text-muted
                                        select#id_multimedia.form-select.border-start-0.rounded-end-3(name="id_multimedia")
                                            option(value="") -- Sin asignar --
                                            if miembros && miembros.length
                                                each m in miembros
                                                    option(value=m.id_miembro selected=(logistica.id_multimedia == m.id_miembro))= `${m.nombre} ${m.apellido}`

                                //- Sección: Logística Operativa (Aseo)
                                .col-md-6
                                    label.form-label.fw-semibold.text-secondary(for="id_aseo")
                                        i.bi.bi-sparkles.text-success.me-2
                                        | Responsable de Aseo / Ornato
                                    .input-group
                                        span.input-group-text.border-end-0(style="background-color: var(--ijersac-bg);"): i.bi.bi-person-badge.text-muted
                                        select#id_aseo.form-select.border-start-0.rounded-end-3(name="id_aseo")
                                            option(value="") -- Sin asignar --
                                            if miembros && miembros.length
                                                each m in miembros
                                                    option(value=m.id_miembro selected=(logistica.id_aseo == m.id_miembro))= `${m.nombre} ${m.apellido}`

                                //- Observaciones Especiales
                                .col-12
                                    label.form-label.fw-semibold.text-secondary(for="observaciones") Observaciones / Requerimientos Especiales
                                    textarea#observaciones.form-control.rounded-3(
                                        name="observaciones" 
                                        rows="4" 
                                        placeholder="Ej: Se requiere micrófono extra para instrumento, el predicador traerá diapositivas, coordinar apertura de puertas más temprano, etc."
                                    ) #{logistica.observaciones || ''}

                            //- Botonera corporativa asimétrica integrada
                            .d-flex.gap-3.pt-2.mt-5.border-top
                                a.btn.btn-light.w-25.py-2.fw-bold.rounded-3.text-secondary(href="/service" style="background-color: var(--ijersac-bg); border: none;") Cancelar
                                button.btn.btn-action.flex-grow-1.py-2.fw-bold.rounded-3.shadow-sm(type="submit")
                                    i.bi.bi-check-all.me-2
                                    | Guardar Parámetros de Logística

block scripts
    style.
        /* Soporte para bordes responsivos en tarjetas informativas */
        @media (min-width: 768px) {
            .border-end-md {
                border-end: 0;
                border-right: 1px solid #e2e8f0 !important;
            }
        }
        .x-small {
            font-size: 0.72rem;
            letter-spacing: 0.5px;
        }