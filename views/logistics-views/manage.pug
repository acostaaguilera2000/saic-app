extends ../layout

block content
  .container-fluid.px-4.py-4

    //- Encabezado institucional global con inyección dinámica del ID del culto
    +formHeader(
      `Logística del Servicio #${culto.id_culto}`, 
      '/service', 
      [
        { text: 'SAIC', link: '/dashboard', active: false },
        { text: 'Cultos', link: '/service', active: false },
        { text: 'Gestión Logística', active: true }
      ]
    ) 

    .row.justify-content-center
      .col-12.col-lg-10.col-xl-8

        //- Gestión de Mensajes y Alertas Globales de SAIC
        include ../partials/_messages

        //- Información de Referencia del Culto (Tarjeta Visual Bento)
        .card.border-0.mb-4(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento);")
          .card-body.p-4
            .row.g-3.align-items-center.text-center.text-md-start
              
              .col-md-4.border-end-md
                span.text-uppercase.text-muted.fw-bold.d-block.mb-1(style="font-size: 0.72rem; letter-spacing: 0.5px;") Servicio seleccionado
                h5.fw-bold.mb-0.text-dark #{culto.tipo_culto}

              .col-md-4.border-end-md
                span.text-uppercase.text-muted.fw-bold.d-block.mb-1(style="font-size: 0.72rem; letter-spacing: 0.5px;") Fecha y Hora
                p.small.mb-0.text-dark.fw-semibold
                  i.bi.bi-calendar3.me-2(style="color: var(--calm-green-primary);")
                  - var fCulto = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short'}) : 'No asignada' 
                  | #{fCulto} — #{culto.hora ? culto.hora.substring(0, 5) : 'Por definir'}

              .col-md-4
                span.text-uppercase.text-muted.fw-bold.d-block.mb-1(style="font-size: 0.72rem; letter-spacing: 0.5px;") Altar (Predicación)
                p.small.mb-0.text-dark.fw-semibold
                  i.bi.bi-megaphone.me-2(style="color: var(--calm-green-primary);")
                  | #{culto.id_predicador ? `${culto.nombre_predicador} ${culto.apellido_predicador}` : (culto.predicador_externo || 'Por asignar')}

        //- Formulario de Gestión Logística (Caja Bento Principal)
        .card.bento-card.border-0(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento);")
          .card-body.p-4

            //- Subcabecera descriptiva interna adaptada
            .d-flex.align-items-center.mb-4.p-2.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
              i.bi.bi-sliders2-vertical.fs-5.me-2
              span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Asignación de Roles Operativos y Técnicos

            form(action=`/logistic/manage/${culto.id_culto}` method="POST")
              .row.g-4

                //- Sección: Soporte Técnico (Sonido)
                .col-md-6
                  label.form-label.fw-semibold.text-secondary(for="id_sonido")
                    i.bi.bi-sliders.me-2(style="color: var(--calm-green-primary);")
                    | Ingeniería de Sonido
                  .input-group
                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-person-badge.text-muted
                    select#id_sonido.form-select.border-start-0.rounded-end-3(name="id_sonido" style="border-color: var(--border-subtle);")
                      option(value="") -- Sin asignar --
                      if miembros && miembros.length
                        each m in miembros
                          option(value=m.id_miembro selected=(logistica.id_sonido == m.id_miembro))= `${m.nombre} ${m.apellido}`

                //- Sección: Soporte Técnico (Multimedia)
                .col-md-6
                  label.form-label.fw-semibold.text-secondary(for="id_multimedia")
                    i.bi.bi-pc-display-horizontal.me-2(style="color: var(--calm-green-primary);")
                    | Multimedia y Proyección
                  .input-group
                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-person-badge.text-muted
                    select#id_multimedia.form-select.border-start-0.rounded-end-3(name="id_multimedia" style="border-color: var(--border-subtle);")
                      option(value="") -- Sin asignar --
                      if miembros && miembros.length
                        each m in miembros
                          option(value=m.id_miembro selected=(logistica.id_multimedia == m.id_miembro))= `${m.nombre} ${m.apellido}`

                //- Sección: Logística Operativa (Aseo)
                .col-md-6
                  label.form-label.fw-semibold.text-secondary(for="id_aseo")
                    i.bi.bi-sparkles.me-2(style="color: var(--calm-green-primary);")
                    | Responsable de Aseo / Ornato
                  .input-group
                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-person-badge.text-muted
                    select#id_aseo.form-select.border-start-0.rounded-end-3(name="id_aseo" style="border-color: var(--border-subtle);")
                      option(value="") -- Sin asignar --
                      if miembros && miembros.length
                        each m in miembros
                          option(value=m.id_miembro selected=(logistica.id_aseo == m.id_miembro))= `${m.nombre} ${m.apellido}`

                //- Observaciones Especiales
                .col-12
                  label.form-label.fw-semibold.text-secondary(for="observaciones") Observaciones / Requerimientos Especiales
                  textarea#observaciones.form-control.rounded-3(
                    name="observaciones" 
                    rows="4" 
                    placeholder="Ej: Se requiere micrófono extra para instrumento, el predicador traerá diapositivas, coordinar apertura de puertas más temprano, etc."
                    style="border-color: var(--border-subtle);"
                  ) #{logistica.observaciones || ''}

              //- Botonera corporativa estandarizada
              .d-flex.gap-3.pt-2.mt-5.border-top(style="border-color: var(--border-subtle) !important;")
                a.btn-light-custom.w-25(href="/service") Cancelar
                button.btn-premium.flex-grow-1(type="submit")
                  i.bi.bi-check-all.me-2
                  | Guardar Parámetros de Logística

block scripts
  style.
    /* Manejo del divisor responsive adaptado a las variables del sistema */
    @media (min-width: 768px) {
        .border-end-md {
            border-bottom: 0;
            border-right: 1px solid var(--border-subtle) !important;
        }
    }