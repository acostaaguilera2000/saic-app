doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")
    meta(name="theme-color" content="#0a192f")

    title Acceso | IJERSAC

    // Precarga de imagen (IMPORTANTE)
    link(
      rel="preload"
      as="image"
      href="/img/fondo-login.webp"
    )

    // Bootstrap
    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

    // Bootstrap Icons
    link(
      rel="stylesheet" 
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"

    )

    // CSS propio
    link(rel="stylesheet" href="/css/login.css")

  body

 
    main.container-fluid.main-wrapper

      .row.main-content

        // =========================
        // PANEL IZQUIERDO
        // =========================
        section.col-lg-6.left-panel

          .brand-container

            .brand-line

            h1.brand-title SAIC

            p.brand-subtitle
              | Software Administrativo Para Iglesias Cristianas

            .brand-verse
              | Todo lo que hagan, háganlo de corazón,
              br
              | como para el Señor.
              br
              br
              | Colosenses 3:23


        // =========================
        // PANEL DERECHO
        // =========================
        section.col-lg-6.right-panel

          .login-box

            h2.login-title Bienvenido

            p.login-subtitle
              | Inicia sesión para acceder al sistema


            // Error backend
            if error
              .custom-error
                i.bi.bi-exclamation-triangle-fill.me-2
                | #{error}


            form(action="/auth/login" method="POST" autocomplete="on")

              // EMAIL
              .field
                i.bi.bi-envelope

                input.input-custom(
                  type="email"
                  name="email"
                  value=( valores ? valores.email : '')
                  placeholder="Correo electrónico"
                  autocomplete="email"
                  required
                )

              // PASSWORD
              .field
                i.bi.bi-lock

                input.input-custom(
                  type="password"
                  name="password"
                  placeholder="Contraseña"
                  autocomplete="current-password"
                  required
                )

              button.login-btn(type="submit")
                i.bi.bi-box-arrow-in-right.me-2
                | Iniciar sesión


              .bottom-links
                a(href="#") Recuperar contraseña
                a(href="#") Soporte técnico


    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    )
