extends ../layout

block content
    .row.justify-content-center
        .col-lg-10
            //- Encabezado con navegación y contexto (Estructura visual limpia de SAIC)
            .d-flex.align-items-center.justify-content-between.mb-4
                div
                    .d-flex.align-items-center.gap-3
                        img.rounded-circle.shadow-sm(
                            src=`https://ui-avatars.com/api/?name=${miembroToEdit.nombre}+${miembroToEdit.apellido}&background=0D6EFD&color=fff&size=48` 
                            alt="Avatar"
                        )
                        div
                            h2.fw-bold.text-dark.mb-0 Modificar Datos de Miembro
                            p.text-muted.small.mb-0 Actualizando la información del registro: 
                                strong.text-primary ##{miembroToEdit.id_miembro}

                a.btn.btn-outline-secondary.btn-sm.rounded-pill.px-3(href="/members")
                    i.bi.bi-arrow-left.me-2
                    | Volver a la lista

            //- Bloque de Alertas/Errores para evitar perder lo digitado si falla la validación
            if errores && errores.length > 0
                .alert.alert-danger.alert-dismissible.fade.show.border-0.shadow-sm.mb-4(role="alert")
                    .d-flex.align-items-center
                        i.bi.bi-exclamation-triangle-fill.me-3.fs-4
                        div
                            strong.d-block.mb-1 Por favor, corrija los siguientes errores:
                            ul.mb-0.ps-3.small
                                each err in errores
                                    li #{err}
                    button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

            //- Tarjeta de Edición Principal
            .card.card-custom.border-0.shadow-sm
                .card-body.p-4.p-md-5
                    form(action=`/members/update/${miembroToEdit.id_miembro}` method="POST")
                        .row.g-4
                            //- Sección: Datos de Identidad Básica
                            .col-12
                                .d-flex.align-items-center.mb-2
                                    i.bi.bi-person-vcard.text-primary.me-2
                                    span.fw-bold.text-uppercase.small.text-muted Datos Personales e Identidad
                                hr.mt-0.mb-4

                            .col-md-6
                                label.form-label.fw-semibold(for="nombre") Nombres
                                .input-group
                                    span.input-group-text.bg-light: i.bi.bi-person
                                    input#nombre.form-control.bg-light(
                                        type="text" 
                                        name="nombre" 
                                        value=miembroToEdit.nombre 
                                        required
                                    )

                            .col-md-6
                                label.form-label.fw-semibold(for="apellido") Apellidos
                                .input-group
                                    span.input-group-text.bg-light: i.bi.bi-person
                                    input#apellido.form-control.bg-light(
                                        type="text" 
                                        name="apellido" 
                                        value=miembroToEdit.apellido 
                                        required
                                    )

                            .col-md-12
                                label.form-label.fw-semibold(for="documento") Documento de Identidad
                                .input-group
                                    span.input-group-text.bg-light: i.bi.bi-card-text
                                    input#documento.form-control.bg-light(
                                        type="text" 
                                        name="documento" 
                                        value=miembroToEdit.documento 
                                        required
                                    )

                            //- Sección: Datos Eclesiásticos / Fechas
                            .col-12.mt-5
                                .d-flex.align-items-center.mb-2
                                    i.bi.bi-calendar-check.text-primary.me-2
                                    span.fw-bold.text-uppercase.small.text-muted Fechas de Registro y Sacramentos
                                hr.mt-0.mb-4

                            .col-md-6
                                label.form-label.fw-semibold(for="fecha_registro") Fecha de Ingreso/Registro
                                .input-group
                                    span.input-group-text.bg-light: i.bi.bi-calendar-event
                                    //- Conversión nativa segura de fecha ISO a YYYY-MM-DD para compatibilidad estricta con input type="date"
                                    - var dateReg = miembroToEdit.fecha_registro ? new Date(miembroToEdit.fecha_registro).toISOString().split('T')[0] : ''
                                    input#fecha_registro.form-control.bg-light(
                                        type="date" 
                                        name="fecha_registro" 
                                        value=dateReg 
                                        required
                                    )

                            .col-md-6
                                label.form-label.fw-semibold(for="fecha_bautismo") Fecha de Bautismo
                                .input-group
                                    span.input-group-text.bg-light: i.bi.bi-droplet
                                    - var dateBau = miembroToEdit.fecha_bautismo ? new Date(miembroToEdit.fecha_bautismo).toISOString().split('T')[0] : ''
                                    input#fecha_bautismo.form-control.bg-light(
                                        type="date" 
                                        name="fecha_bautismo" 
                                        value=dateBau
                                    )
                                small.text-muted.d-block.mt-1 Opcional. Dejar vacío si el miembro aún no se encuentra bautizado.

                        //- Botones Finales de Acción (Perfectamente alineados)
                        .d-flex.justify-content-end.gap-3.mt-5
                            a.btn.btn-light.px-4.fw-bold.border(href="/members") Cancelar
                            button.btn.btn-action.px-5.shadow-sm(type="submit")
                                i.bi.bi-save.me-2
                                | Guardar Cambios