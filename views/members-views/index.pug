extends ../layout

block styles
    link(rel="stylesheet" href="/css/tablas-institucionales.css")

block content
    //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
    .container-fluid.px-4.py-4

        //- Encabezado de Página Institucional Adaptativo (Estilo Bento Box Superior)
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4.p-4.rounded-4(style="background: #ffffff; box-shadow: 0 4px 24px rgba(0,0,0,0.02);")
            div
                h2.fw-bold.text-dark.mb-1 Gestión de Miembros
                p.text-muted.small.mb-0 Administra el registro general de miembros, sus datos de identificación y estados eclesiásticos.

            a.btn.btn-action.shadow-sm.px-4.py-2.fw-semibold.rounded-3(href="/members/create")
                i.bi.bi-person-plus-fill.me-2
                | Nuevo Miembro

        //- Notificaciones y Mensajes de Operación (Ancho completo adaptativo)
        include ../partials/_messages

        //- Contenedor Principal (Tabla adaptada para DataTables y CSS unificado)
        .card.bento-card.border-0.shadow-sm.overflow-hidden(style="background: #ffffff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.03);")
            .card-body.p-4
                .table-responsive
                    table.table.table-hover.align-middle.mb-0.tabla-institucional#tabla-members
                        thead
                            tr
                                th.ps-4.py-3(style="width: 80px; background-color: var(--ijersac-bg); color: var(--ijersac-navy);") ID
                                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") NOMBRES Y APELLIDOS
                                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") DOCUMENTO
                                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") REGISTRO
                                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") ESTADO BAUTISMO
                                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") ESTADO SISTEMA
                                th.pe-4.py-3.text-end(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") ACCIONES

                        tbody
                            if miembros && miembros.length > 0
                                each miembro in miembros
                                    //- Si está inactivo, aplicamos la clase atenuada para distinción visual rápida
                                    tr(class=miembro.activo === 0 ? "miembro-inactivo" : "")
                                        td.ps-4
                                            span.id-badge.fw-bold(style="color: var(--ijersac-navy);") ##{miembro.id_miembro}

                                        td
                                            .d-flex.align-items-center
                                                img.rounded-circle.me-3.avatar-miembro(
                                                    src=`https://ui-avatars.com/api/?name=${miembro.nombre}+${miembro.apellido}&background=${miembro.activo === 1 ? '0a192f' : '64748b'}&color=fff&size=40&font-size=0.35&bold=true` 
                                                    width="38" 
                                                    height="38"
                                                    alt="Avatar"
                                                )
                                                div
                                                    span.nombre-miembro.d-block.fw-bold #{miembro.nombre} #{miembro.apellido}

                                        td
                                            span.small.fw-semibold.text-secondary #{miembro.documento}

                                        td
                                            span.small.text-muted
                                                - var fRegistro = miembro.fecha_registro ? new Date(miembro.fecha_registro).toLocaleDateString('es-ES', {timeZone: 'UTC'}) : 'No definida' 
                                                | #{fRegistro}

                                        td
                                            if miembro.fecha_bautismo
                                                - var fBautismo = new Date(miembro.fecha_bautismo).toLocaleDateString('es-ES', {timeZone: 'UTC'})
                                                span.badge.badge-bautizado.px-3.py-2.fw-semibold
                                                    i.bi.bi-water.me-1
                                                    | Bautizado (#{fBautismo})
                                            else
                                                span.badge.badge-no-bautizado.px-3.py-2.fw-semibold
                                                    i.bi.bi-hourglass-split.me-1
                                                    | No Bautizado

                                        td
                                            if miembro.activo === 1
                                                span.badge.badge-sistema-activo.px-2.py-1.fw-semibold
                                                    i.bi.bi-check-circle-fill.me-1
                                                    | Activo
                                            else
                                                span.badge.badge-sistema-inactivo.px-2.py-1.fw-semibold
                                                    i.bi.bi-x-circle-fill.me-1
                                                    | Inactivo

                                        td.pe-4.text-end
                                            .d-flex.justify-content-end.gap-2
                                                a.btn.btn-sm.btn-accion-editar.rounded-3(
                                                    href=`/members/update/${miembro.id_miembro}`
                                                    title="Editar Datos"
                                                )
                                                    i.bi.bi-pencil-square

                                                //- Manejo dinámico del conmutador de estado con SweetAlert2
                                                if miembro.activo === 1
                                                    button.btn.btn-sm.btn-accion-inactivar.rounded-3(
                                                        type="button" 
                                                        title="Inactivar Miembro"
                                                        onclick=`confirmarCambioEstado('${miembro.id_miembro}', '${miembro.nombre} ${miembro.apellido}', 1)`
                                                    )
                                                        i.bi.bi-toggle-on
                                                else
                                                    button.btn.btn-sm.btn-accion-activar.rounded-3(
                                                        type="button" 
                                                        title="Activar Miembro"
                                                        onclick=`confirmarCambioEstado('${miembro.id_miembro}', '${miembro.nombre} ${miembro.apellido}', 0)`
                                                    )
                                                        i.bi.bi-toggle-off
                            else
                                tr
                                    td.text-center.py-5.text-muted(colspan="7") 
                                        i.bi.bi-people.d-block.fs-2.mb-2.text-black-50
                                        | No hay miembros registrados en este momento.

block scripts
    style.
        /* Atenuación elegante para filas inactivas */
        .miembro-inactivo {
            background-color: #f8fafc !important;
            opacity: 0.65;
        }

        .nombre-miembro {
            color: var(--ijersac-navy-light);
            font-size: 0.92rem;
        }
        .avatar-miembro {
            border: 2px solid #eef2f5;
        }

        /* Badges de estados eclesiásticos en tonos pastel */
        .badge-bautizado {
            background-color: #e8f5e9 !important;
            color: #2e7d32 !important;
            border: 1px solid #c8e6c9 !important;
            font-size: 11px;
        }
        .badge-no-bautizado {
            background-color: #fff3e0 !important;
            color: #ef6c00 !important;
            border: 1px solid #ffe0b2 !important;
            font-size: 11px;
        }

        /* Estilos para Badges del Sistema */
        .badge-sistema-activo {
            background-color: #e0f2fe !important;
            color: #0369a1 !important;
            font-size: 10.5px;
        }
        .badge-sistema-inactivo {
            background-color: #fee2e2 !important;
            color: #b91c1c !important;
            font-size: 10.5px;
        }

        /* Estilos avanzados con micro-interacciones para botones de control */
        .btn-accion-editar {
            background-color: #f8fafc;
            color: var(--ijersac-navy-light);
            border: 1px solid #e2e8f0;
            transition: all 0.2s ease;
        }
        .btn-accion-editar:hover {
            background-color: var(--ijersac-navy-light);
            color: #ffffff;
        }
        .btn-accion-inactivar {
            background-color: #fff1f2;
            color: #f43f5e;
            border: 1px solid #ffe4e6;
            transition: all 0.2s ease;
        }
        .btn-accion-inactivar:hover {
            background-color: #f43f5e;
            color: #ffffff;
        }
        .btn-accion-activar {
            background-color: #f0fdf4;
            color: #16a34a;
            border: 1px solid #dcfce7;
            transition: all 0.2s ease;
        }
        .btn-accion-activar:hover {
            background-color: #16a34a;
            color: #ffffff;
        }

    script(src="/js/modules/member.js")