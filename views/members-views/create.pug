extends ../layout

block content
    .container-fluid.px-4.py-4

        //- Encabezado estándar global mediante mixin institucional con migajas de pan
        +formHeader(
            'Registrar Nuevo Miembro', 
            '/members', 
            [
                { text: 'SAIC', link: '/dashboard', active: false },
                { text: 'Miembros', link: '/members', active: false },
                { text: 'Registrar', active: true }
            ]
        )

        //- Contenedor de formulario centrado estructurado en estilo bento
        .row.justify-content-center
            .col-12.col-lg-10.col-xl-8
                include ../partials/_messages
                .card.bento-card.p-4.mb-4.border-0(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento);")

                    form(action="/members/create" method="POST")
                        .row.g-4

                            //- Sección: Datos Demográficos e Identificación
                            .col-12
                                .d-flex.align-items-center.p-2.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
                                    i.bi.bi-person-vcard-fill.fs-5.me-2
                                    span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Información Personal Básica

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="nombre") Nombres
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-person.text-muted
                                    input#nombre.form-control.border-start-0.rounded-end-3(
                                        type="text" 
                                        name="nombre" 
                                        value=(valores && valores.nombre ? valores.nombre : '') 
                                        placeholder="Ej. Juan Carlos" 
                                        required
                                    )

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="apellido") Apellidos
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-person.text-muted
                                    input#apellido.form-control.border-start-0.rounded-end-3(
                                        type="text" 
                                        name="apellido" 
                                        value=(valores && valores.apellido ? valores.apellido : '') 
                                        placeholder="Ej. Pérez Gómez" 
                                        required
                                    )

                            .col-12
                                label.form-label.fw-semibold.text-secondary(for="documento") Documento de Identidad
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-card-text.text-muted
                                    input#documento.form-control.border-start-0.rounded-end-3(
                                        type="text" 
                                        name="documento" 
                                        value=(valores && valores.documento ? valores.documento : '') 
                                        placeholder="Número de Cédula de Ciudadanía" 
                                        required
                                    )

                            //- Sección: Fechas Cronológicas y Estado Eclesiástico
                            .col-12.mt-5
                                .d-flex.align-items-center.p-2.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
                                    i.bi.bi-calendar-check-fill.fs-5.me-2
                                    span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Registro Eclesiástico

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="fecha_registro") Fecha de Ingreso / Registro
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-calendar-plus.text-muted
                                    input#fecha_registro.form-control.border-start-0.rounded-end-3(
                                        type="date" 
                                        name="fecha_registro" 
                                        value=(valores && valores.fecha_registro ? valores.fecha_registro : '') 
                                        required
                                    )

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="fecha_bautismo") Fecha de Bautismo
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-droplet.text-muted
                                    input#fecha_bautismo.form-control.border-start-0.rounded-end-3(
                                        type="date" 
                                        name="fecha_bautismo" 
                                        value=(valores && valores.fecha_bautismo ? valores.fecha_bautismo : '')
                                    )
                                small.form-text.text-muted Dejar en blanco si el miembro no se encuentra bautizado.

                        //- Alocación de botones de acción mediante componentes globales del sistema
                        .d-flex.gap-3.pt-2.mt-5.border-top(style="border-color: var(--border-subtle) !important;")
                            a.btn-light-custom.w-25(href="/members") Cancelar
                            button.btn-premium.flex-grow-1(type="submit")
                                i.bi.bi-save.me-2
                                | Guardar Miembro