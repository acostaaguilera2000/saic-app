//- partials/messages.pug

//- Notificaciones de operaciones exitosas (flash success_msg)
if success_msg && success_msg.length > 0
    .alert.alert-success.border-0.shadow-sm.alert-dismissible.fade.show.mb-3(role="alert" style="border-radius: 12px;")
        .d-flex.align-items-center
            i.bi.bi-check-circle-fill.me-3.fs-5
            div
                strong.small= success_msg
        button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

//- Notificaciones de excepciones o errores en tiempo de ejecución (flash error_msg)
if error_msg && error_msg.length > 0
    .alert.alert-danger.border-0.shadow-sm.alert-dismissible.fade.show.mb-3(role="alert" style="border-radius: 12px;")
        .d-flex.align-items-center
            i.bi.bi-exclamation-triangle-fill.me-3.fs-5
            div
                strong.small= error_msg
        button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

//- Notificaciones estructurales para colecciones de errores de validación de esquemas (Array)
if errores && errores.length > 0
    .alert.alert-danger.border-0.shadow-sm.mb-3(role="alert" style="border-radius: 12px;")
        .d-flex.align-items-center.mb-2.p-1.rounded-2(style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545;")
            i.bi.bi-exclamation-octagon-fill.me-2.fs-5
            h6.mb-0.fw-bold.small Restricciones de Validación Detectadas
        ul.mb-0.small.ps-4.pt-1.text-secondary
            each error in errores
                li.mb-1= error