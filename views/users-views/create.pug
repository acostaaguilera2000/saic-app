extends ../layout

block content
  .container-fluid.px-4.py-4

    //- Encabezado estandarizado global mediante mixin institucional
    +formHeader(
      'Registrar Usuario', 
      '/users', 
      [
        { text: 'SAIC', link: '/dashboard', active: false },
        { text: 'Usuarios', link: '/users', active: false },
        { text: 'Crear', active: true }
      ]
    )

    //- Contenedor de formulario centrado estructurado en estilo bento
    .row.justify-content-center
      .col-12.col-lg-10.col-xl-8
        include ../partials/_messages
        .card.bento-card.p-4.mb-4.border-0(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento);")

          form(action="/users/create" method="POST" novalidate=false)
            .row.g-4

              //- Sección: Credenciales de cuenta de usuario
              .col-12
                .d-flex.align-items-center.p-2.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
                  i.bi.bi-person-badge-fill.fs-5.me-2
                  span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Credenciales de Acceso

              .col-md-6
                label.form-label.fw-semibold.text-secondary(for="username") Nombre de Usuario
                .input-group
                  span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-at.text-muted
                  input.form-control.border-start-0.rounded-end-3(
                    type="text" 
                    id="username" 
                    name="username" 
                    required
                    minlength="3"
                    pattern="^[a-zA-Z0-9_.]+$"
                    title="Solo letras, números, puntos o guiones bajos."
                    value= valores ? valores.username : ''
                  )
                small.form-text.text-muted Mínimo 3 caracteres (letras, números, puntos o _).

              .col-md-6
                label.form-label.fw-semibold.text-secondary(for="email") Correo Electrónico
                .input-group
                  span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-envelope.text-muted
                  input.form-control.border-start-0.rounded-end-3(
                    type="email" 
                    id="email" 
                    name="email" 
                    required
                    value= valores ? valores.email : ''
                  )
                small.form-text.text-muted Correo institucional o personal obligatorio.

              .col-md-6
                label.form-label.fw-semibold.text-secondary(for="password") Contraseña
                .input-group
                  span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-lock.text-muted
                  input.form-control.border-start-0(
                    type="password" 
                    id="password" 
                    name="password" 
                    required
                    minlength="6"
                  )
                  button.btn.btn-outline-secondary.border-start-0(type="button" onclick="togglePassword(event)" style="background-color: var(--bg-app); border-color: var(--border-subtle);")
                    i.bi.bi-eye.text-muted
                small.form-text.text-muted Obligatoria. Debe contener al menos 6 caracteres.

              .col-md-6
                label.form-label.fw-semibold.text-secondary(for="rol") Rol de Usuario
                .input-group
                  span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-shield-lock.text-muted
                  select.form-select.border-start-0.rounded-end-3(id="rol" name="rol" required)
                    option(value="" disabled selected= !valores) Seleccione un privilegio...
                    option(value="admin" selected= (valores && valores.rol === 'admin')) Administrador
                    option(value="tesorero" selected= (valores && valores.rol === 'tesorero')) Tesorero
                    option(value="lider" selected= (valores && valores.rol === 'lider')) Líder Ministerial
                    option(value="miembro" selected= (valores && valores.rol === 'miembro')) Miembro General
                small.form-text.text-muted Define los privilegios de acceso en el sistema.

              //- Sección: Vinculación de identidad de miembro
              .col-12.mt-5
                .d-flex.align-items-center.p-2.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
                  i.bi.bi-link-45deg.fs-5.me-2
                  span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Vinculación con Miembro

              .col-12
                label.form-label.fw-semibold.text-secondary(for="id_miembro") Seleccionar Miembro Asociado
                .input-group.mb-1
                  span.input-group-text.border-end-0(style="background-color: var(--bg-app); border-color: var(--border-subtle);"): i.bi.bi-people.text-muted
                  select.form-select.border-start-0.rounded-end-3(id="id_miembro" name="id_miembro")
                    option(value="" selected= (!valores || valores.id_miembro === "")) Ninguno (Usuario Externo)
                    if availableMembers && availableMembers.length > 0
                      each miembro in availableMembers
                        option(
                          value=miembro.id_miembro 
                          selected= (valores && valores.id_miembro == miembro.id_miembro)
                        )= `${miembro.nombre} ${miembro.apellido} — Doc: ${miembro.documento}`
                small.form-text.d-block.mt-1(style="color: var(--ijersac-red-light); font-weight: 500;")
                  i.bi.bi-info-circle-fill.me-1
                  | Si no selecciona un miembro, el sistema lo registrará automáticamente como un Usuario Externo.

            //- Alocación de botones de acción mediante componentes globales del sistema
            .d-flex.gap-3.pt-2.mt-5.border-top(style="border-color: var(--border-subtle) !important;")
              a.btn-light-custom.w-25(href="/users") Cancelar
              button.btn-premium.flex-grow-1(type="submit")
                i.bi.bi-person-check.me-2
                | Guardar Usuario

block scripts
  script.
    function togglePassword(event) {
      const input = document.getElementById('password');
      const icon = event.currentTarget.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
      }
    }