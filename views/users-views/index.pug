extends ../layout

block styles


block content
  //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
  .container-fluid.px-4.py-4

    //- Encabezado de Página Institucional (Estilo Bento Box Superior de CalmMind)
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4.p-4.rounded-4(style="background: var(--bg-surface); border: var(--border-subtle);")
      div
        h2.fw-bold.text-main.mb-1 Gestión de Usuarios
        p.text-muted.small.mb-0 Administra el acceso, las credenciales y los roles del personal administrativo.

      a.btn.btn-primary.btn-premium(href="/users/create")
        i.bi.bi-person-plus-fill.me-2
        | Nuevo Usuario

    //- Gestión de Mensajes y Alertas Globales 
    include ../partials/_messages

    //- Contenedor Principal de la Tabla (Card Bento unificada usando tables.css)
    .table-responsive-custom
     
      table.table.table-hover.align-middle.mb-0.tabla-institucional#tabla-user
        thead
          tr
            th.ps-4.py-3(style="width: 80px;") ID
            th.py-3 USUARIO
            th.py-3 EMAIL
            th.py-3 ROL
            th.py-3 MIEMBRO ASOCIADO
            th.pe-4.py-3.text-end ACCIONES

        tbody
          if usuarios && usuarios.length > 0
            each usuario in usuarios
              tr
                //- ID del usuario utilizando tokens heredados
                td.ps-4
                  span.fw-bold.text-main ##{usuario.id_usuario}

                //- Bloque del perfil / avatar del usuario
                td
                  .d-flex.align-items-center
                    img.rounded-circle.me-3(
                      src=`https://ui-avatars.com/api/?name=${usuario.username || 'User'}&background=0a192f&color=fff&size=40&font-size=0.35&bold=true` 
                      width="38" 
                      height="38"
                      alt="Avatar"
                      style="border: 2px solid var(--bg-app);"
                    )
                    div
                      span.d-block.fw-bold.text-main(style="font-size: 0.92rem;") #{usuario.username}

                //- Email
                td
                  span.small.text-muted.fw-medium #{usuario.email}

                //- Roles de Acceso con Badges de tu components.css / variables.css
                td
                  if usuario.rol === 'admin'
                    span.badge-status.badge-status-success
                      i.bi.bi-shield-check.me-1
                      | ADMIN
                  else
                    span.badge-status(style="background-color: var(--bg-app); color: var(--text-muted); border: var(--border-subtle);")
                      i.bi.bi-person-badge.me-1
                      | #{usuario.rol.toUpperCase()}

                //- Miembro Asociado (Lógica externa preservada)
                td
                  if usuario.nombre && usuario.apellido
                    span.text-muted.small.fw-medium #{usuario.nombre} #{usuario.apellido}
                  else
                    span.badge-status(style="background-color: rgba(245, 158, 11, 0.06); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.15);")
                      i.bi.bi-globe.me-1
                      | Externo

                //- Botones de acción unificados con components.css
                td.pe-4.text-end
                  .d-flex.justify-content-end.gap-2
                    a.btn-table-action-edit(
                      href=`/users/update/${usuario.id_usuario}`
                      title="Editar Usuario"
                    )
                      i.bi.bi-pencil-square

                    button.btn-table-action-delete(
                      type="button" 
                      title="Eliminar Usuario"
                      onclick=`confirmarEliminacion('${usuario.id_usuario}', '${usuario.username}')`
                    )
                      i.bi.bi-trash
          else
            tr
              td.text-center.py-5.text-muted(colspan="6") 
                i.bi.bi-person-x.d-block.display-6.text-disabled.mb-3
                span No hay usuarios registrados en el sistema.

block scripts
  //- El script local se remueve por completo ya que las reglas ahora se manejan por clases globales
  script(src="/js/modules/user.js")