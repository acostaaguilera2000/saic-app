extends ../layout

block content
    //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
    .container-fluid.px-4.py-4

        //- Encabezado de la Vista estilo Bento Box Superior
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4.p-4.rounded-4(style="background: var(--bg-surface); box-shadow: var(--shadow-bento);")
            div
                h2.fw-bold.text-dark.mb-1 Panel de Ministerios
                p.text-muted.small.mb-0 Gestión de los grupos de operaciones, servicios y asignaciones litúrgicas de la congregación.

            button.btn.btn-premium.px-4.py-2(data-bs-toggle="modal" data-bs-target="#createMinistryModal")
                i.bi.bi-plus-lg.me-2
                | Nuevo Ministerio

        //- Gestión de Mensajes y Alertas Globales (Ancho completo adaptativo)
        include ../partials/_messages

        //- Contenedor Bento Grid (Estructura Asimétrica Optimizada)
        .row.g-3
            if datos && datos.length > 0
                each ministerio, index in datos
                    //- Alternamos el tamaño de las tarjetas de forma dinámica para crear el efecto Bento de SAIC
                    - const colSize = (index % 3 === 0) ? 'col-lg-8' : 'col-lg-4'

                    div(class=`col-12 ${colSize}`)
                        .card.bento-card.h-100.p-4.d-flex.flex-column.justify-content-between.border-0(
                            style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important; transition: transform 0.2s ease, border-color 0.2s ease;" 
                            onmouseover="this.style.borderColor='var(--calm-green-primary)'; this.style.transform='translateY(-3px)';" 
                            onmouseout="this.style.borderColor='var(--border-subtle)'; this.style.transform='none';"
                        )
                            div
                                .d-flex.justify-content-between.align-items-start.mb-3
                                    //- Caja de icono representativo con colores institucionales unificados
                                    .icon-box.rounded-3.d-flex.align-items-center.justify-content-center(style="width: 42px; height: 42px; background-color: var(--calm-green-subtle);")
                                        i.bi.bi-collection-fill(style="color: var(--calm-green-primary); font-size: 1.2rem;")

                                    span.badge.text-secondary.border.px-2.py-1(style="font-size: 0.72rem; letter-spacing: 0.5px; background-color: var(--bg-app); border-color: var(--border-subtle) !important;")= `ID: #0${ministerio.id_ministerio}`

                                h4.fw-bold.mb-2.text-dark= ministerio.nombre
                                p.text-muted.mb-4(style="font-size: 0.72rem; line-height: 1.5; letter-spacing: 0.1px;")= ministerio.descripcion

                            .d-flex.justify-content-end.align-items-center.pt-3.border-top(style="border-color: var(--border-subtle) !important;")
                                a.btn.btn-action-manage.btn-sm.fw-semibold.px-3.py-2.rounded-3(href=`/ministries/${ministerio.id_ministerio}`)
                                    | Gestionar Integrantes
                                    i.bi.bi-arrow-right.ms-2
            else
                .col-12
                    .card.bento-card.p-5.text-center.border-0(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento);")
                        .card-body.py-4
                            i.bi.bi-folder-x.display-4.text-muted.mb-3
                            h5.fw-bold.text-dark No hay ministerios registrados
                            p.text-muted.mx-auto.mb-0(style="font-size: 0.72rem; max-width: 400px; letter-spacing: 0.1px;") Crea un ministerio usando el botón superior para comenzar a asignar miembros locales y estructurar los equipos.

    //- Modal Institucional para la Creación de Ministerios
    .modal.fade#createMinistryModal(tabindex="-1" aria-labelledby="createMinistryModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
            .modal-content.border-0.shadow-lg(style="border-radius: 16px; background: var(--bg-surface);")

                //- Cabecera del Modal
                .modal-header.border-0.pb-0.pt-4.px-4
                    h5.modal-title.fw-bold.text-dark#createMinistryModalLabel Nuevo Ministerio Administrativo
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

                .modal-body.pt-3.px-4.pb-4
                    //- Subcabecera informativa interna del modal (Verde / Calm)
                    .d-flex.align-items-center.mb-3.p-2.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
                        i.bi.bi-info-circle-fill.me-2
                        span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px; font-size: 0.75rem;") Registro de Estructuras Litúrgicas

                    form(action="/ministries/create" method="POST")
                        .mb-3
                            label.form-label.fw-bold.text-secondary(for="nombre" style="font-size: 0.72rem; letter-spacing: 0.5px;") Nombre del Ministerio
                            input.form-control.rounded-3#nombre(
                                type="text" 
                                name="nombre" 
                                value=(valores ? valores.nombre : '') 
                                placeholder="Ej: Ministerio de Alabanza" 
                                style="border-color: var(--border-subtle);"
                                required
                            )

                        .mb-3
                            label.form-label.fw-bold.text-secondary(for="descripcion" style="font-size: 0.72rem; letter-spacing: 0.5px;") Descripción Operativa
                            textarea.form-control.rounded-3#descripcion(
                                name="descripcion" 
                                rows="4" 
                                placeholder="Describe brevemente las funciones, responsabilidades y alcances de este grupo dentro de la congregación..." 
                                style="border-color: var(--border-subtle);"
                                required
                            )= (valores ? valores.descripcion : '')

                        //- Botonera estandarizada interna del modal
                        .d-flex.justify-content-end.gap-2.mt-4.pt-3.border-top(style="border-color: var(--border-subtle) !important;")
                            button.btn.btn-light-custom.px-4(type="button" data-bs-dismiss="modal") Cancelar
                            button.btn.btn-premium.px-4(type="submit") Registrar Ministerio