extends ../layout

block content
  //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
  .container-fluid.px-4.py-4

    //- Gestión de Mensajes y Alertas Globales de Validación / Operación
    include ../partials/_messages

    //- ==========================================
    //- ENCABEZADO DE CONTEXTO ASIMÉTRICO (BENTO)
    //- ==========================================
    .row.g-3.mb-4
      // Bloque Informativo del Ministerio Principal
      .col-12.col-lg-8
        .card.bento-card.border-0.p-4.h-100.d-flex.flex-column.justify-content-between(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          div
            span.badge.text-success.fw-bold.text-uppercase.mb-2(style="background-color: var(--calm-green-subtle); font-size: 0.72rem; letter-spacing: 0.5px;") Activo Operacional
            h2.fw-bold.text-dark.mb-2= datos.ministry.nombre
            p.text-muted.mb-0(style="font-size: 0.72rem;") Código del Ministerio: #0#{datos.ministry.id_ministerio}

          .mt-4.pt-2.border-top(style="border-color: var(--border-subtle) !important;")
            a.btn.btn-light-custom.btn-sm.fw-semibold.px-3.rounded-3(href="/ministries")
              i.bi.bi-arrow-left.me-2
              | Volver al panel general

      // Bloque Bento de Métricas e Información Rápida
      .col-12.col-lg-4
        .card.bento-card.border-0.p-4.h-100.d-flex.flex-column.justify-content-between(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          h6.fw-bold.text-muted.text-uppercase.mb-3(style="font-size: 0.72rem; letter-spacing: 0.5px;") Resumen de Dotación

          .d-flex.align-items-center.justify-content-between.mb-2.pb-2.border-bottom(style="border-color: var(--border-subtle) !important;")
            .d-flex.align-items-center.gap-2
              .icon-box.rounded-3.d-flex.align-items-center.justify-content-center(style="width: 30px; height: 30px; background-color: var(--calm-green-subtle);")
                i.bi.bi-people-fill(style="color: var(--calm-green-primary); font-size: 0.85rem;")
              span.text-secondary.fw-medium(style="font-size: 0.75rem;") Integrantes actuales:
            span.fw-bold.text-dark= datos.currentMembers ? datos.currentMembers.length : 0

          .d-flex.align-items-center.justify-content-between
            .d-flex.align-items-center.gap-2
              .icon-box.rounded-3.d-flex.align-items-center.justify-content-center(style="width: 30px; height: 30px; background-color: var(--warning-subtle, #fef3c7);")
                i.bi.bi-person-plus-fill.text-warning(style="font-size: 0.85rem;")
              span.text-secondary.fw-medium(style="font-size: 0.75rem;") Personal asignable:
            span.fw-bold.text-dark= datos.assignableMembers ? datos.assignableMembers.length : 0

    //- ==========================================
    //- CUERPO OPERATIVO ASIMÉTRICO
    //- ==========================================
    .row.g-4
      // Columna Izquierda: Información del Ministerio y Asignación
      .col-12.col-lg-4
        .card.bento-card.border-0.p-4.mb-4(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          .d-flex.align-items-center.gap-3.mb-3
            .icon-box.rounded-3.d-flex.align-items-center.justify-content-center(style="width: 36px; height: 36px; background-color: var(--calm-green-subtle);")
              i.bi.bi-bookmark-star-fill(style="color: var(--calm-green-primary);")
            h5.fw-bold.mb-0.text-dark Descripción Operativa

          p.text-muted.mb-0(style="line-height: 1.6; font-size: 0.75rem; letter-spacing: 0.1px;")= datos.ministry.descripcion

        // Tarjeta Bento para la Asignación Dinámica de Miembros Activos
        .card.bento-card.border-0.p-4(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          .d-flex.align-items-center.mb-3.p-2.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
            i.bi.bi-person-plus-fill.me-2
            span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px; font-size: 0.75rem;") Incorporar Miembro Activo

          if datos.assignableMembers && datos.assignableMembers.length > 0
            form(action="/ministries/add-member" method="POST")
              input(type="hidden" name="id_ministerio" value=datos.ministry.id_ministerio)

              .mb-3
                label.form-label.fw-bold.text-secondary.text-uppercase(for="id_miembro" style="font-size: 0.72rem; letter-spacing: 0.5px;") Seleccionar Hermano
                select.form-select.rounded-3#id_miembro(name="id_miembro" style="border-color: var(--border-subtle);" required)
                  option(value="" disabled selected) -- Seleccione un miembro activo --
                  each candidato in datos.assignableMembers
                    option(value=candidato.id_miembro)= `${candidato.apellido}, ${candidato.nombre}`

              button.btn.btn-premium.w-100.mt-2.py-2(type="submit")
                i.bi.bi-plus-circle.me-2
                | Asignar al Grupo
          else
            .text-center.py-3
              i.bi.bi-person-check-fill.text-success.display-6.mb-2
              p.text-muted.mb-0(style="font-size: 0.72rem;") Todos los miembros activos ya pertenecen a este ministerio.

      // Columna Derecha: Tabla Limpia de Integrantes Actuales
      .col-12.col-lg-8
        .card.bento-card.border-0.p-4(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          h5.fw-bold.text-dark.mb-3 Integrantes Vinculados

          if datos.currentMembers && datos.currentMembers.length > 0
            .table-responsive
              table.table.table-hover.align-middle.mb-0
                thead
                  tr(style="border-bottom: 2px solid var(--border-subtle);")
                    th.text-secondary.fw-bold(style="width: 15%; font-size: 0.72rem;") ID
                    th.text-secondary.fw-bold(style="width: 65%; font-size: 0.72rem;") Nombre Completo
                    th.text-secondary.fw-bold(style="width: 20%; font-size: 0.72rem;").text-center Acciones
                tbody
                  each integrante in datos.currentMembers
                    tr.event-row
                      td
                        span.text-muted.fw-mono(style="font-size: 0.72rem;")= `#0${integrante.id_miembro}`
                      td
                        .d-flex.align-items-center.gap-3
                          // Avatar usando inicial mapeado al diseño limpio de la App
                          .rounded-circle.d-flex.align-items-center.justify-content-center.fw-bold.text-secondary(style="width: 32px; height: 32px; border: 1px solid var(--border-subtle); background-color: var(--bg-app) !important; font-size: 0.75rem;")
                            = integrante.apellido.charAt(0)
                          span.fw-semibold.text-dark(style="font-size: 0.78rem;")= `${integrante.apellido}, ${integrante.nombre}`
                      td.text-center
                        form(action="/ministries/remove-member" method="POST" onsubmit=`confirmarDesvinculacion(event, '${integrante.nombre} ${integrante.apellido}');`)
                          input(type="hidden" name="id_ministerio" value=datos.ministry.id_ministerio)
                          input(type="hidden" name="id_miembro" value=integrante.id_miembro)
                          button.btn.btn-link.text-danger.p-0.border-0(type="submit" title="Desvincular miembro" style="background: none;")
                            i.bi.bi-trash3-fill.fs-6
          else
            .text-center.py-5
              i.bi.bi-people.display-5.text-muted.mb-3
              h6.fw-bold.text-dark Sin integrantes actualmente
              p.text-muted.mb-0(style="font-size: 0.72rem;") Utiliza el panel de asignación de la izquierda para vincular personal activo.

block scripts
  script.
    function confirmarDesvinculacion(event, nombreCompleto) {
        event.preventDefault();
        const formulario = event.target;

        Swal.fire({
            title: '¿Desvincular miembro?',
            text: `¿Estás seguro de remover a ${nombreCompleto} de este ministerio? Dejará de figurar en la lista de integrantes actuales de forma inmediata.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f43f5e',
            cancelButtonColor: 'var(--border-subtle)',
            confirmButtonText: 'Sí, desvincular',
            cancelButtonText: 'Cancelar',
            background: 'var(--bg-surface)',
            customClass: {
                popup: 'rounded-4 border-0',
                title: 'fw-bold text-dark'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                formulario.submit();
            }
        });
    }

  style.
    .fw-mono { font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .bento-card { transition: transform 0.2s ease, border-color 0.2s ease; }
    .bento-card:hover { border-color: var(--calm-green-primary) !important; }