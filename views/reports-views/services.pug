extends ../layout

block content
    //- Control Web de Reportes (Oculto en Impresión)
    .d-flex.justify-content-between.align-items-center.mb-4.d-print-none
        div
            h3.fw-bold.text-dark.mb-1 Cronograma Oficial de Servicios
            p.text-muted.small Vista analítica y distribución en formato PDF institucional.
        .d-flex.gap-2
            button.btn.btn-dark.px-4.shadow-sm(type="button" onclick="window.print()")
                i.bi.bi-printer.me-2
                | Imprimir Documento
            a.btn.btn-light.border.px-3(href="/service") Ir a servicios

    //- Filtro de Meses por Servidor (Oculto en Impresión)
    .card.border-0.shadow-sm.mb-4.d-print-none
        .card-body.p-3.bg-light
            form(method="GET" action="/report/services")
                .row.align-items-center.g-2
                    .col-md-3
                        label.form-label.fw-bold.text-dark.mb-0(for="month")
                            i.bi.bi-filter-left.me-2
                            | Seleccionar Mes del Reporte:
                    .col-md-4
                        select#month.form-select(name="month" onchange="this.form.submit()")
                            option(value="") -- Mostrar todos los meses --
                            each mes, index in ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']
                                - var val = String(index + 1).padStart(2, '0')
                                option(value=val selected=(selectedMonth === val)) #{mes}

    //- Contenedor del Reporte (Formato Imprimible Extendido)
    .card.border-0.shadow-sm.card-reporte
        .card-body.p-4.p-md-5

            //- Encabezado Membrete Oficial
            .row.align-items-end.mb-4.encabezado-reporte
                .col-7.text-start
                    h2.fw-bold.mb-1.titulo-iglesia IGLESIA JESÚS DE NAZARET
                    span.badge.bg-dark.text-uppercase.px-2.py-1.small-badge Registro Operativo Central
                .col-5.text-end
                    span.d-block.text-uppercase.fw-bold.text-secondary.small-title DOCUMENTO INFORMATIVO
                    span.d-block.text-muted.x-small Agenda General de Servicios
                    span.d-block.text-muted.x-small Emitido el: #{new Date().toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' })}

            .linea-separadora.mb-4

            //- Tabla de Distribución Plana (6 Columnas)
            .table-responsive
                table.table.align-middle.tabla-institucional
                    thead
                        tr
                            th(style="width: 15%;") Fecha / Hora
                            th(style="width: 13%;") Servicio
                            th(style="width: 18%;") Dirección
                            th(style="width: 18%;") Predicación
                            th(style="width: 18%;") Soporte Técnico
                            th(style="width: 20%;") Observaciones
                    tbody
                        if cronograma && cronograma.length > 0
                            each item in cronograma
                                tr.fila-reporte
                                    //- Columna 1: Fecha y Hora
                                    td.celda-fecha

                                        //- Tratamiento de fecha visual segura en UTC
                                        - var f = item.fecha ? new Date(item.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'short'}) : 'No asignada' 
                                        span.text-uppercase.d-block.fw-bold.txt-institucional #{f}
                                        if item.hora
                                            - var [horas, minutos] = item.hora.split(':')
                                            - var fechaBase = new Date(2000, 0, 1, horas, minutos)
                                            - var horaFormateada = fechaBase.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true })
                                            span.text-muted.small.fw-semibold #{horaFormateada}
                                        else
                                            span.text-muted.small.fw-semibold Por definir

                                    //- Columna 2: Liturgia / Tipo de Culto
                                    td
                                        span.badge-servicio #{item.tipo_culto}

                                    //- Columna 3: Dirección (Limpia)
                                    td.texto-assigned
                                        | #{item.dir_nom ? `${item.dir_nom} ${item.dir_ape}` : item.dirigente_externo || 'Por asignar'}

                                    //- Columna 4: Predicación (Limpia)
                                    td.texto-assigned
                                        | #{item.pred_nom ? `${item.pred_nom} ${item.pred_ape}` : item.predicador_externo || 'Por asignar'}

                                    //- Columna 5: Soporte Técnico / Logística Compacta
                                    td.celda-logistica
                                        if item.son_nom
                                            div
                                                span.subtitulo-rol Sonido: 
                                                span.texto-logistica-name #{item.son_nom}
                                        if item.mul_nom
                                            div.mt-1
                                                span.subtitulo-rol Multi: 
                                                span.texto-logistica-name #{item.mul_nom}
                                        if item.ase_nom
                                            div.mt-1
                                                span.subtitulo-rol Aseo: 
                                                span.texto-logistica-name #{item.ase_nom}

                                    //- Columna 6: Observaciones Dedicada
                                    td.txt-observacion
                                        | #{item.observaciones && item.observaciones.trim() !== "" ? item.observaciones : 'Sin novedades.'}
                        else
                            tr
                                td.text-center.py-5.text-muted.fst-italic(colspan="6") No se encuentran programaciones registradas para el periodo seleccionado.

            //- Pie de Página Formal
            .footer-reporte.text-center.mt-5
                p.mb-1.fst-italic.text-secondary.quote-text "Todo lo que hagáis, hacedlo de corazón, como para el Señor y no para los hombres." — Colosenses 3:23
                .linea-final.my-3
                p.mb-0.text-uppercase.fw-semibold.system-tag SAIC — SISTEMA DE ADMINISTRACIÓN DE IGLESIAS CRISTIANAS

block scripts
    style.
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        /* Configuración Base Impresion/Web */
        .card-reporte, .tabla-institucional, .encabezado-reporte, .footer-reporte {
            font-family: 'Inter', sans-serif !important;
            -webkit-font-smoothing: antialiased;
        }

        .titulo-iglesia { font-weight: 800 !important; color: #1e293b; letter-spacing: -0.5px; }
        .small-badge { font-size: 9px !important; letter-spacing: 1px; background-color: #1e293b !important; }
        .small-title { font-size: 10px; letter-spacing: 1.5px; color: #475569 !important; }
        .linea-separadora { height: 1px; background-color: #cbd5e1; width: 100%; }
        .linea-final { height: 1px; background-color: #e2e8f0; width: 150px; margin: 0 auto; }

        /* Estilo de la Tabla Plana */
        .tabla-institucional thead th {
            background-color: #1e293b !important;
            color: #ffffff !important;
            font-size: 10.5px;
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 10px 8px !important;
            border: none !important;
        }

        .tabla-institucional tbody td {
            padding: 12px 8px !important;
            border-bottom: 1px solid #e2e8f0 !important;
            font-size: 12px;
        }

        /* Elementos Internos */
        .txt-institucional { color: #7f1d1d; font-size: 12px; font-weight: 700; }

        .badge-servicio { 
            background-color: #f8fcf8; 
            color: #334155; 
            padding: 3px 6px; 
            font-size: 10px; 
            font-weight: 600;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            display: inline-block;
            text-transform: uppercase;
        }

        .texto-assigned { color: #0f172a; font-weight: 500; }
        .subtitulo-rol { font-weight: 600; color: #64748b; font-size: 10px; text-transform: uppercase; }
        .texto-logistica-name { color: #334155; font-weight: 500; }
        .txt-observacion { font-size: 11px; color: #475569; line-height: 1.3; }
        .quote-text { font-size: 11px; }
        .system-tag { font-size: 9px; letter-spacing: 1px; color: #94a3b8; }

        /* Estabilizadores Estrictos de Impresión */
        @media print {
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }
            .d-print-none, nav, aside, .sidebar, header, .btn, form { display: none !important; }
            body { background-color: #ffffff !important; color: #000000 !important; }
            .card-reporte { border: none !important; box-shadow: none !important; padding: 0 !important; }
            .card-reporte .card-body { padding: 0 !important; }
            .tabla-institucional thead th { background-color: #1e293b !important; color: #ffffff !important; }
            .badge-servicio { background-color: #f8fafc !important; border: 1px solid #cbd5e1 !important; }
            .txt-institucional { color: #7f1d1d !important; }
            .fila-reporte { page-break-inside: avoid !important; }
        }