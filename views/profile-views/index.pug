extends ../layout

block content
    .container-fluid.px-4.py-4

        //-  1. CONTENIDO DE FORMULARIO CENTRADO 
        .row.justify-content-center
            .col-12.col-lg-10.col-xl-8
                include ../partials/_messages

                .card.bento-card.p-4.mb-4.border-0(style="background: #ffffff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.03);")

                    //- Avatar Dinámico Integrado en la Cabecera Bento Box
                    .d-flex.align-items-center.mb-4.p-3.rounded-3(style="background-color: var(--ijersac-bg);")
                        img.rounded-circle.shadow-sm.me-3(
                            src=`https://ui-avatars.com/api/?name=${user.username}&background=0A192F&color=fff&size=54` 
                            alt="Avatar de Usuario"
                        )
                        div
                            h5.fw-bold.text-dark.m-0 Gestión de Mi Cuenta
                            p.text-muted.small.m-0 Autenticado como: 
                                strong(style="color: var(--ijersac-navy);") #{user.username}
                            span.badge.mt-1.xx-small.text-uppercase.ls-1(style="background-color: var(--ijersac-navy); color: #fff;") #{user.rol}

                    //- Formulario de Actualización
                    form(action="/profile/update" method="POST")
                        .row.g-4

                            //- Sección: Datos de Identidad Básica
                            .col-12
                                .d-flex.align-items-center.p-2.rounded-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);")
                                    i.bi.bi-person-badge.fs-5.me-2
                                    span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Información del Perfil

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="email") Correo Electrónico
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--ijersac-bg);"): i.bi.bi-envelope.text-muted
                                    input.form-control.border-start-0.bg-light.text-muted.rounded-end-3(
                                        type="email" 
                                        id="email" 
                                        value=user.email 
                                        disabled
                                    )
                                small.form-text.text-muted.x-small El correo institucional no es modificable.

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="username") Nombre de Usuario
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--ijersac-bg);"): i.bi.bi-person.text-muted
                                    input.form-control.border-start-0.rounded-end-3(
                                        type="text" 
                                        id="username" 
                                        name="username" 
                                        value=user.username 
                                        required
                                    )
                                small.form-text.text-muted.x-small Nombre visible dentro de la plataforma.

                            //- Sección: Seguridad Crítica (Confirmación Obligatoria)
                            .col-12.mt-5
                                .d-flex.align-items-center.p-2.rounded-3(style="background-color: rgba(220, 53, 69, 0.05); color: #dc3545;")
                                    i.bi.bi-shield-check.fs-5.me-2
                                    span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Confirmación de Identidad Requerida

                            .col-12
                                label.form-label.fw-semibold.text-danger(for="currentPassword") Contraseña Actual
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: rgba(220, 53, 69, 0.02); border-color: #f1f1f1;"): i.bi.bi-key.text-danger
                                    input.form-control.border-start-0(
                                        type="password" 
                                        id="currentPassword" 
                                        name="currentPassword" 
                                        placeholder="Escriba su contraseña actual"
                                        required
                                    )
                                    button.btn.btn-outline-secondary.border-start-0(type="button" onclick="toggleFieldPassword(event, 'currentPassword')" style="background-color: var(--ijersac-bg);")
                                        i.bi.bi-eye.text-muted
                                small.form-text.text-muted.d-block.mt-1
                                    i.bi.bi-info-circle.me-1
                                    | Es obligatorio ingresar su contraseña vigente para guardar cualquier cambio.

                            //- Sección: Cambio de Credenciales (Opcional)
                            .col-12.mt-5
                                .d-flex.align-items-center.p-2.rounded-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);")
                                    i.bi.bi-shield-lock.fs-5.me-2
                                    span.fw-bold.text-uppercase.small(style="letter-spacing: 0.5px;") Modificar Contraseña (Opcional)

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="newPassword") Nueva Contraseña
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--ijersac-bg);"): i.bi.bi-lock.text-muted
                                    input.form-control.border-start-0(
                                        type="password" 
                                        id="newPassword" 
                                        name="newPassword" 
                                        placeholder="Mínimo 6 caracteres"
                                    )
                                    button.btn.btn-outline-secondary.border-start-0(type="button" onclick="toggleFieldPassword(event, 'newPassword')" style="background-color: var(--ijersac-bg);")
                                        i.bi.bi-eye.text-muted
                                small.form-text.text-muted.x-small Dejar en blanco si no desea cambiarla.

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="confirmPassword") Confirmar Nueva Contraseña
                                .input-group
                                    span.input-group-text.border-end-0(style="background-color: var(--ijersac-bg);"): i.bi.bi-lock-check.text-muted
                                    input.form-control.border-start-0(
                                        type="password" 
                                        id="confirmPassword" 
                                        name="confirmPassword" 
                                        placeholder="Repita la nueva contraseña"
                                    )
                                    button.btn.btn-outline-secondary.border-start-0(type="button" onclick="toggleFieldPassword(event, 'confirmPassword')" style="background-color: var(--ijersac-bg);")
                                        i.bi.bi-eye.text-muted
                                small.form-text.text-muted.x-small Ambas contraseñas deben coincidir.

                        //- BOTONERA DE ACCIÓN ASIMÉTRICA
                        .d-flex.gap-3.pt-2.mt-5.border-top
                            a.btn.btn-light.w-25.py-2.fw-bold.rounded-3.text-secondary(href="/dashboard" style="background-color: var(--ijersac-bg); border: none;") Cancelar
                            button.btn.btn-action.flex-grow-1.py-2.fw-bold.rounded-3.shadow-sm(type="submit")
                                i.bi.bi-save.me-2
                                | Guardar Cambios

block scripts
    script.
        function toggleFieldPassword(event, fieldId) {
            const input = document.getElementById(fieldId);
            const icon = event.currentTarget.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }