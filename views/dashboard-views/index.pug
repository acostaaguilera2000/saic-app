extends ../layout

block content
  //-  Header del Dashboard Dinámico
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h4.fw-bold.text-dark.mb-1 Panel de Control Administrativo
      p.text-muted.small Gestión integral y logística operativa de la congregación IJERSAC
    .d-flex.gap-2
      a.btn.btn-white.shadow-sm.btn-sm(href="/report")
        i.bi.bi-download.me-2
        | Reporte PDF
      a.btn.btn-dark.shadow-sm.btn-sm(href="/finance/create")
        i.bi.bi-plus-lg.me-2
        | Nuevo Registro

  //- Gestión de Mensajes y Alertas Globales 
  include ../partials/_messages

  //- MÁSTER BENTO GRID SYSTEM
  .row.g-4

    //- Bloque 1: Gráfico de Crecimiento Financiero (Donaciones Anuales)
    .col-xl-8.col-lg-7
      .card.border-0.shadow-sm.h-100.bento-card
        .card-header.bg-transparent.border-0.p-4.pb-0
          .d-flex.justify-content-between.align-items-center
            div
              h6.fw-bold.text-dark.mb-1 Análisis de Crecimiento
              p.text-muted.x-small Tendencia de nuevos ingresos anuales consolidada
            select.form-select.form-select-sm.border-light.shadow-none.bg-light#yearSelector(style="width: 100px;")
              option(selected= (currentYear === 2026)) 2026
              option(selected= (currentYear === 2025)) 2025
        .card-body.px-4.pb-4.pt-2
          div(style="height: 310px; position: relative;")
            //- Inyectamos el array de 12 meses como un atributo data-* para que JavaScript lo lea limpiamente
            canvas#growthChart(data-database-values=JSON.stringify(data.chartData))

    //- Bloque 2: Módulo de Métricas de Membresía Reales
    .col-xl-4.col-lg-5
      .row.g-3.h-100
        - 
          const metrics = [
            { label: 'Total Miembros', value: data.metrics.total, sub: '+8.5% este mes', color: 'primary', icon: 'bi-people' },
            { label: 'Activos', value: data.metrics.activos, sub: 'En comunión regular', color: 'success', icon: 'bi-person-check' },
            { label: 'Inactivos', value: data.metrics.inactivos, sub: 'Requieren atención', color: 'danger', icon: 'bi-person-x' },
            { label: 'Crecimiento', value: data.metrics.crecimiento, sub: 'Promedio mensual', color: 'warning', icon: 'bi-graph-up-arrow' }
          ]

        each item in metrics
          .col-6
            .card.border-0.shadow-sm.h-100.bento-card.p-2
              .card-body.p-3.d-flex.flex-column.justify-content-between
                .d-flex.justify-content-between.align-items-center.mb-2
                  .icon-box.rounded-3(class=`bg-${item.color}-subtle text-${item.color}`)
                    i.bi(class=item.icon)
                div
                  span.text-muted.x-small.fw-bold.text-uppercase.ls-1= item.label
                  h3.fw-bold.text-dark.my-1= item.value
                  span.d-block.text-muted.xx-small.fw-medium= item.sub

    //- Bloque 3: Usuarios Recientes (Altas en la Plataforma Web)
    .col-xl-5.col-lg-6
      .card.border-0.shadow-sm.h-100.bento-card
        .card-header.bg-transparent.border-0.p-4.pb-0
          .d-flex.justify-content-between.align-items-center
            div
              h6.fw-bold.text-dark.mb-0 Usuarios Recientes
              p.text-muted.x-small Cuentas web creadas recientemente
            span.badge.bg-dark.text-white.px-2.py-1.xx-small Operativo
        .card-body.p-4.pt-2
          .table-responsive
            table.table.table-hover.align-middle.mb-0
              tbody
                if data.recentUsers && data.recentUsers.length > 0
                  each user in data.recentUsers
                    //- Generamos colores fijos basados en el ID para mantener la estética Bento sin romper la UI
                    - const bgColors = ['002855', 'D4AF37', '003a7a']
                    - const colorHex = bgColors[user.id_usuario % bgColors.length]
                    tr
                      td.ps-0(style="width: 50px;")
                        img.rounded-circle(src=`https://ui-avatars.com/api/?name=${encodeURIComponent(user.nombre_completo)}&background=${colorHex}&color=fff` width="38")
                      td
                        div.fw-bold.text-dark.small-text= user.nombre_completo
                        div.text-muted.xx-small= `@${user.username}`
                      td.text-end.pe-0
                        a.btn.btn-light.btn-xs.rounded-circle(href=`/users/update/${user.id_usuario}`)
                          i.bi.bi-arrow-right-short
                else
                  tr
                    td.text-center.text-muted.py-4(colspan="3") No hay usuarios registrados.

    //- Bloque 4: Próximos Eventos de la Agenda Eclesiástica
    .col-xl-7.col-lg-6
      .card.border-0.shadow-sm.h-100.bento-card
        .card-header.bg-transparent.border-0.p-4.pb-0
          .d-flex.justify-content-between.align-items-center
            div
              h6.fw-bold.text-dark.mb-0 Calendario de Próximos Eventos
              p.text-muted.x-small Planificación de cultos y reuniones
            a.text-dark.text-decoration-none.xx-small.fw-bold.border-bottom.border-dark(href="/service") Ver Agenda
        .card-body.p-4.pt-2
          .row.g-3
            if data.upcomingEvents && data.upcomingEvents.length > 0
              each event, index in data.upcomingEvents
                //- Parseo dinámico de fechas para extraer Día y Mes de manera profesional
                - const eventDate = new Date(event.fecha)
                - const day = eventDate.getDate().toString().padStart(2, '0')
                - const month = eventDate.toLocaleString('es-ES', { month: 'short' }).toUpperCase().replace('.', '')
                //- Alternancia estética de badges de estado en base al índice
                - const statusText = index === 0 ? 'Confirmado' : 'Pendiente'
                - const statusColor = index === 0 ? 'success' : 'warning'

                .col-12
                  .p-3.rounded-3.border.d-flex.align-items-center.bg-light.bg-opacity-40.event-row
                    .date-badge.me-3.text-center.bg-white.shadow-sm.rounded-3.p-2(style="min-width: 55px;")
                      span.d-block.fw-bold.text-dark.h5.mb-0= day
                      span.d-block.text-muted.xx-small.fw-bold= month
                    .flex-grow-1
                      h6.mb-1.fw-bold.text-dark.small-text= event.tipo_culto
                      small.text-muted.xx-small
                        i.bi.bi-clock.me-1
                        | #{event.hora.substring(0, 5)} hrs — Auditorio Central SAIC
                    span.badge.border.xx-small(class=`bg-${statusColor}-subtle text-${statusColor} border-${statusColor}-subtle`) #{statusText}
            else
              .col-12.text-center.text-muted.py-4
                p.mb-0 No hay cultos programados para los próximos días.

block scripts
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script(src="/js/charts-dashboard.js")