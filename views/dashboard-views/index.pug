extends ../layout

block content
  //- HEADER OPTIMIZADO: Bienvenida Personalizada y Consistencia en Pantallas Chicas
  .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.mb-4.pt-3.gap-3
    div
      h4.fw-bold.text-dark.mb-1 Bienvenido de nuevo, #{user ? user.username : 'Manuel Acosta'}
      p.text-muted.x-small Sistema  SAIC Operando para la congregación IJERSAC.
    //- Botones limpios, compactos y responsivos
  

  //- Gestión de Mensajes y Alertas Globales 
  include ../partials/_messages

  //- MÁSTER BENTO GRID SYSTEM
  .row.g-4.match-height-grid

    //- FILA SUPERIOR: Las 4 Tarjetas de Métricas de Membresía distribuidas horizontalmente
    - 
      const metrics = [
        { label: 'Total Miembros', value: data.metrics.total, sub: '+8.5% este mes', color: 'sonido', icon: 'bi-people' },
        { label: 'Activos', value: data.metrics.activos, sub: 'En comunión regular', color: 'sonido', icon: 'bi-person-check' },
        { label: 'Inactivos', value: data.metrics.inactivos, sub: 'Requieren atención', color: 'multimedia', icon: 'bi-person-x' },
        { label: 'Crecimiento', value: data.metrics.crecimiento, sub: 'Promedio mensual', color: 'aseo', icon: 'bi-graph-up-arrow' }
      ]

    each item in metrics
      .col-xl-3.col-sm-6.d-flex.flex-column
        .bento-card.w-100.h-100.p-3.d-flex.flex-column.justify-content-between
          .d-flex.justify-content-between.align-items-start.mb-2
            span.text-muted.xx-small.text-uppercase.ls-1.fw-bold= item.label
            span.badge-status(class=`badge-status-${item.color}`)
              i.bi(class=item.icon)
          .mt-2
            h3.fw-bold.text-dark.mb-1= item.value
            span.d-block.text-muted.xx-small.fw-medium= item.sub

    //- SEGUNDA FILA: Gráfico de Crecimiento (7 col) + Usuarios Recientes (5 col)
    .col-xl-7.col-lg-7.d-flex.flex-column
      .bento-card.w-100.h-100.d-flex.flex-column
        .d-flex.justify-content-between.align-items-center.mb-3
          div
            h5.fw-bold.text-dark.mb-1 Análisis de Crecimiento
            p.text-muted.x-small Tendencia de nuevos ingresos anuales consolidada
          select.form-select-custom#yearSelector(style="width: 100px; height: 36px; font-size: 0.85rem;")
            option(selected= (currentYear === 2026)) 2026
            option(selected= (currentYear === 2025)) 2025
        
        .chart-container-bento.flex-grow-1.d-flex.align-items-center(style="position: relative; height: 310px; width: 100%;")
          canvas#growthChart(data-database-values=JSON.stringify(data.chartData))

    .col-xl-5.col-lg-5.d-flex.flex-column
      .bento-card.w-100.h-100.d-flex.flex-column
        .d-flex.justify-content-between.align-items-center.mb-3
          div
            h5.fw-bold.text-dark.mb-0 Usuarios Recientes
            p.text-muted.x-small Cuentas web creadas recientemente
          span.badge-status.badge-status-sonido.text-xxsmall Operativo
        
        .table-responsive-custom.flex-grow-1.border-0.shadow-none.p-0.m-0
          table.tabla-institucional.align-middle.mb-0
            tbody
              if data.recentUsers && data.recentUsers.length > 0
                each user in data.recentUsers
                  - const bgColors = ['059669', '10b981', '475569']
                  - const colorHex = bgColors[user.id_usuario % bgColors.length]
                  tr
                    td.ps-0(style="width: 45px;")
                      img.rounded-circle(src=`https://ui-avatars.com/api/?name=${encodeURIComponent(user.nombre_completo)}&background=${colorHex}&color=fff` width="34")
                    td
                      div.fw-bold.text-dark.small-text= user.nombre_completo
                      div.text-disabled.xx-small= `@${user.username}`
                    td.text-end.pe-0
                      a.btn-table-action.btn-table-action-edit.rounded-circle.p-2.d-inline-flex.align-items-center.justify-content-center(href=`/users/update/${user.id_usuario}` style="width: 32px; height: 32px;")
                        i.bi.bi-arrow-right-short
              else
                tr
                  td.text-center.text-muted.py-4 No hay usuarios registrados.

    //- TERCERA FILA (ASIMÉTRICA): Calendario (7 col) + Soporte Técnico e Incidentes (5 col)
    .col-xl-7.col-lg-7.d-flex.flex-column
      .bento-card.w-100.h-100.d-flex.flex-column
        .d-flex.justify-content-between.align-items-center.mb-4
          div
            h5.fw-bold.text-dark.mb-0 Calendario de Próximos Eventos
            p.text-muted.x-small Planificación de cultos y reuniones de la congregación
          a.p-0.text-dark.xx-small.fw-bold.text-decoration-none.border-bottom.border-dark(href="/service" style="height: auto;") Ver Agenda
        
        .row.g-3.flex-grow-1
          if data.upcomingEvents && data.upcomingEvents.length > 0
            each event, index in data.upcomingEvents
              - const eventDate = new Date(event.fecha)
              - const day = eventDate.getDate().toString().padStart(2, '0')
              - const month = eventDate.toLocaleString('es-ES', { month: 'short' }).toUpperCase().replace('.', '')
              - const badgeStyle = index === 0 ? 'badge-status-sonido' : 'badge-status-aseo'
              - const statusText = index === 0 ? 'Confirmado' : 'Pendiente'

              .col-12
                .p-3.rounded-3.d-flex.align-items-center.event-row(style="background-color: var(--bg-app); border: var(--border-subtle);")
                  .date-badge.me-3.text-center.bg-white.rounded-3.p-2(style="min-width: 52px; border: var(--border-subtle);")
                    span.d-block.fw-bold.text-dark.mb-0(style="font-size: 1.1rem; line-height: 1;")= day
                    span.d-block.text-disabled(style="font-size: 0.62rem; font-weight:700;")= month
                  .flex-grow-1
                    h6.mb-1.fw-bold.text-dark.small-text= event.tipo_culto
                    small.text-disabled.xx-small
                      i.bi.bi-clock.me-1
                      | #{event.hora.substring(0, 5)} hrs — Auditorio Central SAIC
                  span.badge-status(class=badgeStyle) #{statusText}
          else
            .col-12.text-center.text-muted.py-4.my-auto
              p.mb-0 No hay cultos programados para los próximos días.

    //- NUEVA CARD BENTO: Centro de Soporte, Errores y Estado del Servidor
    .col-xl-5.col-lg-5.d-flex.flex-column
      .bento-card.w-100.h-100.d-flex.flex-column
        .d-flex.justify-content-between.align-items-center.mb-3
          div
            h5.fw-bold.text-dark.mb-0 Soporte y Reporte de Errores
            p.text-muted.x-small Estado de la plataforma informática SAIC
          span.badge-status.badge-status-sonido.text-xxsmall Canales Activos
        
        //- Cuerpo interactivo del Centro de Soporte
        .flex-grow-1.d-flex.flex-column.justify-content-between.gap-3.mt-2
          .p-3.rounded-3.d-flex.align-items-center.gap-3(style="background-color: var(--bg-app); border: var(--border-subtle);")
            .brand-icon-box.flex-shrink-0(style="background-color: rgba(16, 185, 129, 0.1); color: var(--calm-green-light);")
              i.bi.bi-cpu-fill
            div
              h6.fw-bold.text-dark.small-text.mb-0 Rendimiento del Servidor
              p.text-disabled.xx-small.mb-0 Latencia: 14ms | Base de datos: Conectada óptimamente

          .p-3.rounded-3.d-flex.align-items-center.gap-3(style="background-color: var(--bg-app); border: var(--border-subtle);")
            .brand-icon-box.flex-shrink-0(style="background-color: rgba(239, 68, 68, 0.1); color: #ef4444;")
              i.bi.bi-exclamation-octagon-fill
            div
              h6.fw-bold.text-dark.small-text.mb-0 ¿Reportar Bug o Incidente?
              p.text-disabled.xx-small.mb-0 Reporta fallos en los roles de usuario o bloqueos logísticos.

          a.btn.btn-table-action.btn-table-action-edit.w-100.py-2.d-flex.align-items-center.justify-content-center.gap-2(href="#" style="font-size: 0.85rem; border-radius: 8px;")
            i.bi.bi-headset
            | Contactar Soporte Técnico

block scripts
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script(src="/js/charts-dashboard.js")