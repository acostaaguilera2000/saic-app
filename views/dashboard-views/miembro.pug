extends ../layout

block content
  .container-fluid.px-4.py-4

    //- Flujo operativo de notificaciones globales
    include ../partials/_messages

    //-  BLOQUE DE BIENVENIDA PREMIUM (Hero adaptativo con el usuario)
    .row.mb-4
      .col-12
        .card.border-0.p-4.bento-card(style="background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-app) 100%); border: 1px solid var(--border-subtle) !important; box-shadow: var(--shadow-bento);")
          .card-body.p-2.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3
            div
              span.badge.badge-status.badge-status-sonido.mb-2 Portal del Miembro
              h2.fw-bold.text-dark.mb-1 ¡Bienvenido, #{datos.profile.nombre || user.username}!
              p.text-secondary.small.mb-0 Gestión de su perfil eclesiástico, cronogramas de servicios y asignaciones logísticas en tiempo real.
            .bg-white.p-3.rounded-4.border.shadow-sm.d-flex.align-items-center.gap-3
              .bento-icon-box.bento-icon-emerald
                i.bi.bi-shield-check.fs-4
              div
                p.mb-0.x-small.text-uppercase.fw-bold.text-secondary Acceso Seguro
                span.badge.badge-status.badge-status-aseo Certificado

    //- SECCIÓN PRINCIPAL: ESTRUCTURA BENTO GRID INTEGRADA
    .row.g-4

      //- BLOQUE 1: FICHA DE REGISTRO INSTITUCIONAL (ANCHO COMPLETO)
      .col-12
        .card.bento-card.border-0.p-4(style="box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          .card-body.p-0
            .d-flex.justify-content-between.align-items-center.mb-3
              .d-flex.align-items-center.gap-2
                .bento-icon-box.bento-icon-emerald
                  i.bi.bi-person-badge-fill.fs-5
                div
                  h3.fs-5.fw-bold.text-dark.mb-0 Información de Identidad Institucional
                  small.text-muted Ficha oficial de registro eclesiástico en SAIC

              //- Badge de Estado Estilizado con Efecto de Pulso Esmeralda
              if datos.profile.activo === 1 || datos.profile.estado === 'Activo'
                span.badge.badge-status.badge-status-sonido.pulse-green.px-3.py-2
                  span.spinner-grow.spinner-grow-sm(style="animation-duration: 1.5s; width: 8px; height: 8px; color: var(--calm-green-primary);")
                  | Miembro Activo
              else
                span.badge.badge-status.badge-status-aseo.px-3.py-2
                  | Inactivo

            hr.opacity-25.my-3(style="color: var(--border-subtle);")

            //- Formulario de Solo Lectura con estética limpia
            form(oninput="return false;")
              p.text-muted.small.fw-bold.mb-3(style="font-size: 0.78rem; letter-spacing: 0.5px; text-transform: uppercase;") 
                i.bi.bi-card-list.me-1.text-success
                | Datos Personales

              .row.g-3.mb-4
                .col-12.col-sm-6.col-md-3
                  label.form-label.form-label-sm Nombres
                  input.form-control.form-control-read(type="text" value=datos.profile.nombre disabled)

                .col-12.col-sm-6.col-md-3
                  label.form-label.form-label-sm Apellidos
                  input.form-control.form-control-read(type="text" value=datos.profile.apellido disabled)

                .col-12.col-sm-6.col-md-3
                  label.form-label.form-label-sm Documento de Identidad
                  input.form-control.form-control-read(type="text" value=(datos.profile.documento || user.username) disabled)

                .col-12.col-sm-6.col-md-3
                  label.form-label.form-label-sm Correo Electrónico
                  input.form-control.form-control-read(type="email" value=(user.email || 'No registrado') disabled)

              p.text-muted.small.fw-bold.mb-3(style="font-size: 0.78rem; letter-spacing: 0.5px; text-transform: uppercase;") 
                i.bi.bi-award.me-1.text-success
                | Registro de Servicio y Alta

              .row.g-3
                .col-12.col-md-6
                  label.form-label.form-label-sm Ministerios Asignados
                  .form-control-read.d-flex.flex-wrap.gap-2.align-items-center.p-2(style="min-height: 45px;")
                    - var mCampo = datos.profile.nombre_ministerio || datos.profile.ministerio
                    if mCampo
                      - var listaMinisterios = Array.isArray(mCampo) ? mCampo : mCampo.split(',')
                      each min in listaMinisterios
                        if min.trim() !== ''
                          span.badge.badge-status.badge-status-sonido.border.d-inline-flex.align-items-center(style="font-size: 0.8rem;")
                            i.bi.bi-bookmark-star.me-1
                            | #{min.trim()}
                    else
                      span.text-muted.small.fst-italic Ninguno asignado

                .col-12.col-md-6
                  label.form-label.form-label-sm Fecha de Bautismo
                  - var fBautismo = datos.profile.fecha_bautismo ? new Date(datos.profile.fecha_bautismo).toLocaleDateString('es-ES', {timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric'}) : 'No registrada' 
                  input.form-control.form-control-read(type="text" value=fBautismo disabled)

      //- BLOQUE 2: TURNO DE SERVICIOS (IZQUIERDA)
      .col-12.col-md-6
        .card.bento-card.border-0.h-100.p-4(style="box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          .card-body.p-0
            .d-flex.align-items-center.gap-2.mb-3
              .bento-icon-box.bento-icon-emerald
                i.bi.bi-calendar-week.fs-5
              h3.fs-5.fw-bold.text-dark.mb-0 Mis Próximos Turnos

            if datos.assignments && datos.assignments.length > 0
              p.text-muted.small.mb-3 Tienes actividades asignadas en el cronograma oficial.

              .d-flex.flex-column.gap-3.overflow-auto.pe-1(style="max-height: 280px;")
                each asignacion in datos.assignments
                  .timeline-item.p-3.border
                    .d-flex.justify-content-between.align-items-start
                      div
                        h5.mb-1.fs-6.fw-bold.text-dark #{asignacion.role_name || asignacion.rol_servicio}
                        p.mb-0.x-small.text-muted 
                          i.bi.bi-layers.me-1
                          | #{asignacion.tipo_culto}
                      .text-end
                        span.badge.badge-status.badge-status-sonido.mb-1 #{asignacion.fecha}
                        div.fw-mono.text-muted(style="font-size: 11px;")
                          i.bi.bi-clock.me-1
                          | #{asignacion.hora}
            else
              .text-center.py-5
                .bento-icon-box.bento-icon-emerald.mx-auto.mb-3(style="width: 54px; height: 54px; border-radius: 50%;")
                  i.bi.bi-calendar2-check.fs-4
                h5.fs-6.fw-bold.text-dark Sin turnos asignados
                p.text-muted.small.mb-0 No registras responsabilidades pendientes en el altar o soporte logístico.

      //- BLOQUE 3: ENLACES RÁPIDOS Y ACCESOS (DERECHA)
      .col-12.col-md-6
        .card.bento-card.border-0.h-100.p-4(style="box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
          .card-body.p-0.d-flex.flex-column.justify-content-between.h-100
            div
              .d-flex.align-items-center.gap-2.mb-3
                .bento-icon-box.bento-icon-slate
                  i.bi.bi-grid-1x2.fs-5
                h3.fs-5.fw-bold.text-dark.mb-0 Enlaces y Herramientas
              p.text-muted.small.mb-4 Utilice estos accesos directos autorizados para auditar la programación general de la congregación o verificar actividades programadas.

            .d-flex.flex-column.gap-3
              a.bento-shortcut-button.p-3.border.d-flex.align-items-center.justify-content-between(href="/service/schedule")
                .d-flex.align-items-center.gap-3
                  .bento-icon-box.bento-icon-emerald
                    i.bi.bi-calendar3.fs-5
                  div.text-start
                    p.mb-0.fw-bold.text-dark(style="font-size: 0.88rem;") Ver Schedule de Cultos
                    small.text-muted.fw-normal(style="font-size: 0.75rem;") Consulta el calendario general de actividades de la iglesia.
                i.bi.bi-arrow-right.text-success.fs-5

block scripts
  style.
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    /* APLICACIÓN DE LA TIPOGRAFÍA GLOBAL SAIC */
    .container-fluid, .form-control-read, .form-label-sm, .timeline-item {
        font-family: 'Inter', sans-serif !important;
        -webkit-font-smoothing: antialiased;
    }

    /* ESTILOS INTERACTIVOS BENTO */
    .bento-card {
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease;
        border-radius: 20px !important;
        background-color: var(--bg-surface, #ffffff);
    }
    .bento-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(5, 150, 105, 0.05) !important;
    }

    /* BOTÓN DIRECTO ESTILO SHORTCUT BENTO */
    .bento-shortcut-button {
        background-color: var(--bg-surface, #ffffff);
        border-radius: 14px;
        border-color: var(--border-subtle, #e2e8f0) !important;
        text-decoration: none !important;
        transition: all 0.25s ease;
    }
    .bento-shortcut-button:hover {
        background-color: var(--bg-app, #f8fafc);
        transform: translateX(4px);
        border-color: var(--calm-green-primary) !important;
    }

    /* REFACTORIZACIÓN CRONOGRAMA DE TURNOS (Menta-Esmeralda suave) */
    .timeline-item {
        border-left: 4px solid var(--calm-green-primary, #059669) !important;
        background-color: var(--bg-app, #f8fafc);
        border-color: var(--border-subtle, #e2e8f0);
        border-radius: 12px;
        transition: all 0.25s ease;
    }
    .timeline-item:hover {
        background-color: var(--bg-surface, #ffffff);
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.06);
    }

    /* DECORADORES DE ICONOS UNIFICADOS */
    .bento-icon-box {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .bento-icon-emerald {
        color: var(--calm-green-primary, #059669);
        background-color: var(--calm-green-subtle, #e6f4ea);
    }
    .bento-icon-slate {
        color: #475569;
        background-color: #f1f5f9;
    }

    /* COMPONENTES DE LECTURA ETIQUETAS */
    .form-control-read {
        background-color: var(--bg-app, #f8fafc) !important;
        border: 1px solid var(--border-subtle, #e2e8f0) !important;
        color: var(--text-main, #0f172a) !important;
        font-weight: 600;
        font-size: 0.88rem;
        border-radius: 10px !important;
        padding: 10px 14px;
    }
    .form-label-sm {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted, #64748b);
        margin-bottom: 5px;
    }

    .pulse-green {
        animation: pulse-g 2.5s infinite;
    }
    @keyframes pulse-g {
        0% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.2); }
        70% { box-shadow: 0 0 0 6px rgba(5, 150, 105, 0); }
        100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
    }
    .x-small { font-size: 11px; }
    .fw-mono { font-family: var(--bs-font-monospace); }