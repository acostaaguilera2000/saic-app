doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title SAIC - App

    //- 1. ESTILOS CORE (Bootstrap e Iconos)
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet")

    //- 2. ESTILOS DE DATATABLES 
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.0.8/css/dataTables.bootstrap5.min.css")

    //- 3. ESTILOS PERSONALIZADOS 
    link(rel="stylesheet" href="/css/dashboard.css")

    //- 4. CONFIGURACIÓN DE SCRIPTS UNIFICADA
    //- Bootstrap sin defer para asegurar los clics del menú del usuario de forma inmediata
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")

    //- Plugins con defer: se ejecutan en orden estricto al terminar de leer el HTML
    script(src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" defer)
    script(src="https://cdn.jsdelivr.net/npm/datatables.net@2.0.8/js/dataTables.min.js" defer)
    script(src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.0.8/js/dataTables.bootstrap5.min.js" defer)

    //- Bloque para inyectar CSS específico desde las vistas
    block styles

  body
    //- Sidebar Escritorio
    aside.sidebar.d-none.d-lg-block
      .sidebar-header
        h3.fw-bold.mb-0(style="color: var(--saic-gold);") SAIC
        small.opacity-75.text-uppercase Admin Church
      .mt-4
        nav.nav.flex-column
          a.nav-link(href="/dashboard" class=(title==='Panel de control' ? 'active' : ''))
            i.bi.bi-grid-1x2-fill.me-3
            | Dashboard
          a.nav-link(href="/users" class=(currentModule==='users' ? 'active' : ''))
            i.bi.bi-person-gear.me-3
            | Usuarios
          a.nav-link(href="/members" class=(currentModule==='members' ? 'active' : ''))
            i.bi.bi-people-fill.me-3
            | Miembros
          a.nav-link(href="/service" class=(currentModule==='service' ? 'active' : '') )
            i.bi.bi-calendar-event.me-3
            | Servicios de culto
          a.nav-link(href="#")
            i.bi.bi-diagram-3.me-3
            | Ministerios
          a.nav-link(href="#")
            i.bi.bi-wallet2.me-3
            | Finanzas
          a.nav-link(href="/report" class=(currentModule==='report' ? 'active' : ''))
            i.bi.bi-bar-chart-line.me-3
            | Reportes

    .main-wrapper
      //- Header
      header.top-header
        h5.mb-0.fw-semibold.text-muted.d-none.d-md-block Bienvenido al sistema, 
          span.text-dark #{user ? user.username : 'Administrador'}
        h5.mb-0.fw-bold.d-md-none(style="color: var(--saic-blue);") SAIC

        .dropdown
          .d-flex.align-items-center.gap-3(style="cursor: pointer;" data-bs-toggle="dropdown")
            .text-end.d-none.d-sm-block
              p.mb-0.fw-bold.lh-1(style="color: var(--saic-blue);") #{user ? user.username : 'Manuel Acosta'}
              small.text-muted #{user ? user.rol : 'Super Admin'}
            img.rounded-circle.shadow-sm(src=`https://ui-avatars.com/api/?name=${user ? user.username : 'Manuel+Acosta'}&background=162a4a&color=fff` width="45")
          ul.dropdown-menu.dropdown-menu-end.border-0.shadow.mt-3
            li: a.dropdown-item.py-2(href=`/profile` class=(currentModule==='profile' ? 'active' : '')): i.bi.bi-person.me-2 Mi Cuenta
            li: hr.dropdown-divider
            li: a.dropdown-item.py-2.text-danger(href="/auth/logout"): i.bi.bi-box-arrow-right.me-2 Salir

      //- Contenido principal
      .content-body
        include ./partials/_messages
        block content

    //- Nav Móvil Sincronizado
    nav.mobile-bottom-nav.d-lg-none.py-2
      .d-flex.justify-content-around.align-items-center
        a.text-white.text-decoration-none.small.text-center(href="/dashboard")
          i.bi.bi-grid-1x2-fill.d-block.fs-4
          | Inicio
        a.text-white.text-decoration-none.small.text-center(href="/members")
          i.bi.bi-people-fill.d-block.fs-4
          | Miembros
        .dropup
          a.text-white.text-decoration-none.small.text-center.dropdown-toggle(data-bs-toggle="dropdown" aria-expanded="false")
            i.bi.bi-plus-circle.d-block.fs-4(style="color: var(--saic-gold);")
            | Más
          ul.dropdown-menu.dropdown-menu-end.shadow.border-0.mb-3
            li: a.dropdown-item(href="/users") 
              i.bi.bi-person-gear.me-2
              | Usuarios
            li: a.dropdown-item(href="/service") 
              i.bi.bi-calendar-event.me-2
              | Servicios de culto
            li: a.dropdown-item(href="#") 
              i.bi.bi-diagram-3.me-2
              | Ministerios
            li: a.dropdown-item(href="#") 
              i.bi.bi-wallet2.me-2
              | Finanzas
            li: hr.dropdown-divider
            li: a.dropdown-item(href="/report") 
              i.bi.bi-bar-chart-line.me-2
              | Reportes

    block scripts