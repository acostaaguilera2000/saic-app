doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")
    title SAIC - App

    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght=400;500;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.0.8/css/dataTables.bootstrap5.min.css")

    //- CSS Propio (Estructura Modular)
    link(rel="stylesheet" href="/css/1-base/variables.css")
    link(rel="stylesheet" href="/css/2-components/components.css")
    link(rel="stylesheet" href="/css/2-components/tables.css")
    link(rel="stylesheet" href="/css/3-layouts/dashboard-layout.css")

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" defer)
    script(src="https://cdn.jsdelivr.net/npm/datatables.net@2.0.8/js/dataTables.min.js" defer)
    script(src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.0.8/js/dataTables.bootstrap5.min.js" defer)
    script(src="/js/sidebar-handler.js" defer)

    block styles

  body
    //- SIDEBAR BLANCO CALMMIND CON ENLACES DINÁMICOS
    aside#sidebarMenu.sidebar.offcanvas-lg.offcanvas-start(tabindex="-1")
      .sidebar-header
        .d-flex.align-items-center.gap-2
          //- Icono de la marca inspirado en CalmMind
          .brand-icon-box
            i.bi.bi-building-gear
          div
            h4.fw-bold.mb-0.sidebar-logo SAIC
            small.sidebar-tagline IJERSAC ADMIN
        //- Botón cerrar exclusivo para pantallas móviles
        button.btn-close.text-reset.d-lg-none.ms-auto(type="button" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu")

      .sidebar-body.mt-4
        nav.nav.flex-column.gap-1
          a.sidebar-link(href="/dashboard" class=(currentModule==='dashboard' ? 'active' : ''))
            i.bi.bi-grid-1x2-fill
            span Overview

          if user && user.rol === 'admin'
            a.sidebar-link(href="/users" class=(currentModule==='users' ? 'active' : ''))
              i.bi.bi-person-gear
              span Usuarios

          if user && ['admin', 'tesorero', 'lider'].includes(user.rol)
            a.sidebar-link(href="/members" class=(currentModule==='members' ? 'active' : ''))
              i.bi.bi-people-fill
              span Miembros

          if user && ['admin', 'lider', 'miembro'].includes(user.rol)
            a.sidebar-link(href="/service/hub" class=(currentModule==='service' ? 'active' : ''))
              i.bi.bi-calendar-event
              span Servicios de Culto

          if user && ['admin', 'lider', 'miembro'].includes(user.rol)
            a.sidebar-link(href="/logistic" class=(currentModule==='logistic' ? 'active' : ''))
              i.bi.bi-truck
              span Logística

          if user && ['admin', 'lider'].includes(user.rol)
            a.sidebar-link(href="/ministries" class=(currentModule==='ministries' ? 'active' : ''))
              i.bi.bi-diagram-3
              span Ministerios

          if user && ['admin', 'tesorero'].includes(user.rol)
            a.sidebar-link(href="/finance" class=(currentModule==='finance' ? 'active' : ''))
              i.bi.bi-wallet2
              span Finanzas

          if user && ['admin', 'tesorero', 'lider'].includes(user.rol)
            a.sidebar-link(href="/report" class=(currentModule==='report' ? 'active' : ''))
              i.bi.bi-bar-chart-line
              span Reportes

    //- CONTENEDOR OPERATIVO PRINCIPAL
    .main-wrapper
      header.top-header
        .d-flex.align-items-center.gap-3
          button.btn-trigger-sidebar.d-lg-none(type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu")
            i.bi.bi-list
          h5.mb-0.fw-semibold.text-muted.d-none.d-md-block Personal Dashboard
          h5.mb-0.fw-bold.d-md-none.txt-navy SAIC

        .dropdown
          .d-flex.align-items-center.gap-3(style="cursor: pointer;" data-bs-toggle="dropdown")
            .text-end.d-none.d-sm-block
              p.mb-0.fw-bold.lh-1.txt-navy(style="font-size: 0.9rem;") #{user ? user.username : 'Manuel Acosta'}
              small.text-disabled.text-uppercase(style="font-size: 0.7rem; font-weight: 700;") #{user ? user.rol : 'Super Admin'}
            //- Cambia la línea de la imagen en tu layout.pug por esta para igualar la paleta:
            img.rounded-circle.border(src=`https://ui-avatars.com/api/?name=${user ? user.username : 'Manuel+Acosta'}&background=059669&color=fff` width="40" height="40" style="border-color: rgba(5, 150, 105, 0.15) !important;")
          ul.dropdown-menu.dropdown-menu-end.border-0.shadow-lg.mt-3.p-2(style="border-radius: 12px;")
            li: a.dropdown-item.py-2.rounded-2(href=`/profile`): i.bi.bi-person.me-2  Mi Cuenta
            li: hr.dropdown-divider.opacity-50
            li: a.dropdown-item.py-2.rounded-2.text-danger(href="/auth/logout"): i.bi.bi-box-arrow-right.me-2  Salir

      main.content-body
        include ./partials/breadcrumbs
        block content

block scripts        

  script(src="js/sidebar-handler.js") 