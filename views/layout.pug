doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title SAIC - App

    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght=400;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.0.8/css/dataTables.bootstrap5.min.css")
    link(rel="stylesheet" href="/css/dashboard.css")

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" defer)
    script(src="https://cdn.jsdelivr.net/npm/datatables.net@2.0.8/js/dataTables.min.js" defer)
    script(src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.0.8/js/dataTables.bootstrap5.min.js" defer)

    block styles

  body
    //- Sidebar Escritorio (Totalmente Plano)
    aside.sidebar.d-none.d-lg-block
      .sidebar-header
        h3.fw-bold.mb-0(style="color: var(--saic-gold);") SAIC
        small.opacity-75.text-uppercase Admin Church
      .mt-4
        nav.nav.flex-column
          a.nav-link(href="/dashboard" class=(currentModule==='dashboard' ? 'active' : ''))
            i.bi.bi-grid-1x2-fill.me-3
            | Dashboard
          
          if user && user.rol === 'admin'
            a.nav-link(href="/users" class=(currentModule==='users' ? 'active' : ''))
              i.bi.bi-person-gear.me-3
              | Usuarios
          
          if user && ['admin', 'tesorero', 'lider'].includes(user.rol)
            a.nav-link(href="/members" class=(currentModule==='members' ? 'active' : ''))
              i.bi.bi-people-fill.me-3
              | Miembros
          
          //- OPCIÓN PLANA QUE APUNTA AL MENÚ INTERMEDIO
          if user && ['admin', 'lider', 'miembro'].includes(user.rol)
            a.nav-link(href="/service/hub" class=(currentModule==='service' ? 'active' : ''))
              i.bi.bi-calendar-event.me-3
              | Servicios de Culto
          
          if user && ['admin', 'lider', 'miembro'].includes(user.rol)
            a.nav-link(href="/logistic" class=(currentModule==='logistic' ? 'active' : ''))
              i.bi.bi-truck.me-3
              | Logística
          
          if user && ['admin', 'lider'].includes(user.rol)
            a.nav-link(href="/ministries" class=(currentModule==='ministries' ? 'active' : ''))
              i.bi.bi-diagram-3.me-3
              | Ministerios
          
          if user && ['admin', 'tesorero'].includes(user.rol)
            a.nav-link(href="/finance" class=(currentModule==='finance' ? 'active' : ''))
              i.bi.bi-wallet2.me-3
              | Finanzas
          
          if user && ['admin', 'tesorero', 'lider'].includes(user.rol)
            a.nav-link(href="/report" class=(currentModule==='report' ? 'active' : ''))
              i.bi.bi-bar-chart-line.me-3
              | Reportes

    .main-wrapper
      header.top-header
        h5.mb-0.fw-semibold.text-muted.d-none.d-md-block Bienvenido al sistema, 
          span.text-dark #{user ? user.username : 'Administrador'}
        h5.mb-0.fw-bold.d-md-none(style="color: var(--saic-blue);") SAIC

        .dropdown
          .d-flex.align-items-center.gap-3(style="cursor: pointer;" data-bs-toggle="dropdown")
            .text-end.d-none.d-sm-block
              p.mb-0.fw-bold.lh-1(style="color: var(--saic-blue);") #{user ? user.username : 'Manuel Acosta'}
              small.text-muted.text-uppercase #{user ? user.rol : 'Super Admin'}
            img.rounded-circle.shadow-sm(src=`https://ui-avatars.com/api/?name=${user ? user.username : 'Manuel+Acosta'}&background=162a4a&color=fff` width="45")
          ul.dropdown-menu.dropdown-menu-end.border-0.shadow.mt-3
            li: a.dropdown-item.py-2(href=`/profile` class=(currentModule==='profile' ? 'active' : '')): i.bi.bi-person.me-2 Mi Cuenta
            li: hr.dropdown-divider
            li: a.dropdown-item.py-2.text-danger(href="/auth/logout"): i.bi.bi-box-arrow-right.me-2 Salir

      .content-body
        include ./partials/breadcrumbs
        block content

    //- Nav Mobile Sincronizado (Plano)
    nav.mobile-bottom-nav.d-lg-none.py-2
      .d-flex.justify-content-around.align-items-center
        a.text-white.text-decoration-none.small.text-center(href="/dashboard" class=(currentModule==='dashboard' ? 'active' : ''))
          i.bi.bi-grid-1x2-fill.d-block.fs-4
          | Inicio
          
        if user && ['admin', 'tesorero', 'lider'].includes(user.rol)
          a.text-white.text-decoration-none.small.text-center(href="/members" class=(currentModule==='members' ? 'active' : ''))
            i.bi.bi-people-fill.d-block.fs-4
            | Miembros
          
        if user && ['admin', 'lider', 'miembro'].includes(user.rol)
          a.text-white.text-decoration-none.small.text-center(href="/service/menu" class=(currentModule==='service' ? 'active' : ''))
            i.bi.bi-calendar-event.d-block.fs-4
            | Cultos

        if user && ['admin', 'tesorero'].includes(user.rol)
          a.text-white.text-decoration-none.small.text-center(href="/finance" class=(currentModule==='finance' ? 'active' : ''))
            i.bi.bi-wallet2.d-block.fs-4
            | Finanzas

        - const showUsers = user && user.rol === 'admin'
        - const showLogistic = user && ['admin', 'lider', 'miembro'].includes(user.rol)
        - const showMinistries = user && ['admin', 'lider'].includes(user.rol)
        - const showReports = user && ['admin', 'tesorero', 'lider'].includes(user.rol)
        - const isMoreActive = ['users', 'ministries', 'report', 'logistic'].includes(currentModule)

        if showUsers || showLogistic || showMinistries || showReports
          .dropup
            a.text-white.text-decoration-none.small.text-center.dropdown-toggle(data-bs-toggle="dropdown" aria-expanded="false" class=(isMoreActive ? 'active' : ''))
              i.bi.bi-plus-circle.d-block.fs-4
              | Más
            ul.dropdown-menu.dropdown-menu-end.shadow.border-0.mb-3
              if showUsers
                li: a.dropdown-item.py-2(href="/users" class=(currentModule==='users' ? 'active' : '')): i.bi.bi-person-gear.me-2 | Usuarios
              if showLogistic
                li: a.dropdown-item.py-2(href="/logistic" class=(currentModule==='logistic' ? 'active' : '')): i.bi.bi-truck.me-2 | Logística
              if showMinistries
                li: a.dropdown-item.py-2(href="/ministries" class=(currentModule==='ministries' ? 'active' : '')): i.bi.bi-diagram-3.me-2 | Ministerios
              if showReports
                li: hr.dropdown-divider
                li: a.dropdown-item.py-2(href="/report" class=(currentModule==='report' ? 'active' : '')): i.bi.bi-bar-chart-line.me-2 | Reportes

block scripts