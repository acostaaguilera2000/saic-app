extends ../layout

block content

    //- Encabezado de página
    .d-flex.flex-wrap.justify-content-between.align-items-center.mb-4
        div
            h2.fw-bold.text-dark.mb-1 Gestión de Miembros
            p.text-muted.small.mb-0 Administra el registro general de miembros, sus datos de identificación y estados eclesiásticos.

        a.btn.btn-action.shadow-sm.px-4(href="/members/create")
            i.bi.bi-person-plus-fill.me-2
            | Nuevo Miembro

    //- Contenedor Principal (Tabla)
    .card.card-custom.border-0.shadow-sm
        .card-body.p-0
            .table-responsive
                table.table.table-hover.align-middle.mb-0
                    thead.bg-light
                        tr
                            th.ps-4.py-3.text-muted.small.fw-bold(style="width: 80px;") ID
                            th.py-3.text-muted.small.fw-bold NOMBRES Y APELLIDOS
                            th.py-3.text-muted.small.fw-bold DOCUMENTO
                            th.py-3.text-muted.small.fw-bold FECHA REGISTRO
                            th.py-3.text-muted.small.fw-bold ESTADO BAUTISMO
                            th.pe-4.py-3.text-muted.small.fw-bold.text-end ACCIONES

                    tbody
                        if miembros && miembros.length > 0
                            each miembro in miembros
                                tr
                                    td.ps-4
                                        span.text-muted.fw-medium ##{miembro.id_miembro}

                                    td
                                        .d-flex.align-items-center
                                            img.rounded-circle.me-3(
                                                src=`https://ui-avatars.com/api/?name=${miembro.nombre}+${miembro.apellido}&background=0d6efd&color=fff&size=40` 
                                                width="40" 
                                                height="40"
                                            )
                                            div
                                                strong.d-block.text-dark(style="font-size: 0.95rem;") #{miembro.nombre} #{miembro.apellido}

                                    td
                                        span.small.text-muted
                                            i.bi.bi-card-text.me-2
                                            | #{miembro.documento}

                                    td
                                        span.small.text-dark
                                            - var fRegistro = miembro.fecha_registro ? new Date(miembro.fecha_registro).toLocaleDateString('es-ES', {timeZone: 'UTC'}) : 'No definida' 
                                            | #{fRegistro}

                                    td
                                        if miembro.fecha_bautismo
                                            - var fBautismo = new Date(miembro.fecha_bautismo).toLocaleDateString('es-ES', {timeZone: 'UTC'})
                                            span.badge.bg-success-subtle.text-success.border.border-success.px-3.py-2
                                                i.bi.bi-water.me-1
                                                | Bautizado (#{fBautismo})
                                        else
                                            span.badge.bg-light.text-muted.border.px-3.py-2
                                                i.bi.bi-hourglass-split.me-1
                                                | No Bautizado

                                    td.pe-4.text-end
                                        .d-flex.justify-content-end.gap-2
                                            a.btn.btn-sm.btn-outline-primary.rounded-pill.px-3(href=`/members/update/${miembro.id_miembro}`)
                                                i.bi.bi-pencil-square

                                            button.btn.btn-sm.btn-outline-danger.rounded-pill.px-3(
                                                type="button" 
                                                title="Inactivar Miembro"
                                                onclick=`confirmarEliminacion('${miembro.id_miembro}', '${miembro.nombre} ${miembro.apellido}')`
                                            )
                                                i.bi.bi-trash
                        else
                            tr
                                td.text-center.py-4.text-muted(colspan="6") No hay miembros registrados o activos en este momento.

block scripts
    script.
        window.confirmarEliminacion = function(id, nombreCompleto) {
            if (confirm(`¿Estás seguro de que deseas dar de baja del sistema al miembro "${nombreCompleto}"?\nEsta acción restringirá su vinculación a nuevas cuentas.`)) {
                window.location.href = `/members/delete/${id}`;
            }
        };