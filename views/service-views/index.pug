extends ../layout

block content
  //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
  .container-fluid.px-4.py-4

    //- Encabezado de Página Institucional (Estilo Bento Box Superior)
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4.p-4.rounded-4(style="background: var(--bg-surface); box-shadow: var(--shadow-bento);")
      div
        h2.fw-bold.text-dark.mb-1 Programación de Servicios
        p.text-muted.small.mb-0 Cronograma de cultos, horarios y asignaciones ministeriales generales.

      //- Contenedor de Acciones Unificado (Uso de componentes globales)
      .d-flex.flex-wrap.align-items-center.gap-2
        a.btn-light-custom.px-3(href="/report/services")
          i.bi.bi-file-earmark-text.me-2
          | Vista Reporte

        a.btn.btn-premium.px-4(href="/service/create")
          i.bi.bi-calendar-plus.me-2
          | Nuevo Servicio

    //- Gestión de Mensajes y Alertas Globales
    include ../partials/_messages

    //- Contenedor Principal (Tabla nativa integrada al ecosistema Bento)
    //- Contenedor Principal de la Tabla (Card Bento unificada usando tables.css)
    .table-responsive-custom
      table.table.table-hover.align-middle.mb-0.tabla-institucional#tabla-cronograma-cultos
        thead
          tr(style="border-bottom: 2px solid var(--border-subtle) !important;")
            th.ps-4.py-3.fw-semibold.small.text-uppercase(style="background-color: var(--bg-app); color: var(--text-primary); width: 80px; letter-spacing: 0.5px;") ID
            th.py-3.fw-semibold.small.text-uppercase(style="background-color: var(--bg-app); color: var(--text-primary); letter-spacing: 0.5px;") FECHA Y HORA
            th.py-3.fw-semibold.small.text-uppercase(style="background-color: var(--bg-app); color: var(--text-primary); letter-spacing: 0.5px;") TIPO DE SERVICIO
            th.py-3.fw-semibold.small.text-uppercase(style="background-color: var(--bg-app); color: var(--text-primary); letter-spacing: 0.5px;") DIRIGENTE
            th.py-3.fw-semibold.small.text-uppercase(style="background-color: var(--bg-app); color: var(--text-primary); letter-spacing: 0.5px;") PREDICADOR
            th.pe-4.py-3.fw-semibold.small.text-uppercase.text-end(style="background-color: var(--bg-app); color: var(--text-primary); letter-spacing: 0.5px;") ACCIONES

        tbody
          if cultos && cultos.length > 0
            each culto in cultos
              tr(style="border-bottom: 1px solid var(--border-subtle);")
                td.ps-4
                  span.id-badge.fw-bold(style="color: var(--calm-green-primary);") ##{culto.id_culto}

                td
                  //- Tratamiento de fecha visual segura en UTC
                  - var f = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'short'}) : 'No asignada' 
                  span.text-uppercase.d-block.fw-bold(style="color: var(--calm-green-primary); font-size: 0.88rem;") #{f}
                  if culto.hora
                    - var [horas, minutos] = culto.hora.split(':')
                    - var fechaBase = new Date(2000, 0, 1, horas, minutos)
                    - var horaFormateada = fechaBase.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true })
                    span.text-muted.small.fw-semibold 
                      i.bi.bi-clock.me-1
                      | #{horaFormateada}
                  else
                    span.text-muted.small.fw-semibold Por definir

                td
                  span.badge.text-uppercase.px-3.py-2.fw-bold(style="background-color: var(--bg-app) !important; color: var(--text-primary) !important; border: 1px solid var(--border-subtle) !important; font-size: 11px; letter-spacing: 0.3px;") #{culto.tipo_culto}

                td
                  if culto.id_dirigente
                    span.small.text-dark.fw-medium
                      | #{culto.nombre_dirigente} #{culto.apellido_dirigente}
                  else if culto.dirigente_externo
                    span.small.text-muted.fw-semibold
                      | #{culto.dirigente_externo} 
                    span.badge.bg-light.text-secondary.ms-1.small (Invitado)
                  else
                    span.small.text-muted.fst-italic Sin asignar

                td
                  if culto.id_predicador
                    span.small.text-dark.fw-medium
                      | #{culto.nombre_predicador} #{culto.apellido_predicador}
                  else if culto.predicador_externo
                    span.small.text-secondary.fw-semibold
                      | #{culto.predicador_externo} 
                    span.badge.bg-light.text-secondary.ms-1.small (Invitado)
                  else
                    span.small.text-muted.fst-italic Sin asignar

                td.pe-4.text-end
                  .d-flex.justify-content-end.gap-2
                    //- Botones estilizados usando clases nativas de Bootstrap yvariables en línea discretas
                    a.btn.btn-sm.btn-light.border.rounded-3.text-info(
                      href=`/logistic/manage/${culto.id_culto}` 
                      title="Gestionar Logística"
                      style="background-color: var(--bg-app); border-color: var(--border-subtle) !important;" 
                    )
                      i.bi.bi-gear-fill

                    a.btn.btn-sm.btn-table-action-edit.border.rounded-3(
                      href=`/service/update/${culto.id_culto}` 
                      title="Editar Servicio"
                      )
                      i.bi.bi-pencil-square

                    button.btn.btn-sm.border.rounded-3.text-danger.btn-table-action-delete(
                      type="button" 
                      title="Eliminar Servicio"
                      data-id=culto.id_culto
                      data-name=culto.tipo_culto
                      data-date=f
                      )
                      i.bi.bi-trash
          else
            tr
              td.text-center.py-5.text-muted(colspan="6") 
                i.bi.bi-calendar-x.d-block.fs-2.mb-2.text-black-50
                | No hay reuniones agendadas en este momento.

block scripts
  script(src="/js/modules/service.js")