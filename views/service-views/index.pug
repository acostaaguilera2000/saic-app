extends ../layout

block styles
  link(rel="stylesheet" href="/css/tablas-institucionales.css")

block content
  //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
  .container-fluid.px-4.py-4

    //- Encabezado de Página Institucional (Estilo Bento Box Superior)
    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4.p-4.rounded-4(style="background: #ffffff; box-shadow: 0 4px 24px rgba(0,0,0,0.02);")
      div
        h2.fw-bold.text-dark.mb-1 Programación de Servicios
        p.text-muted.small.mb-0 Cronograma de cultos, horarios y asignaciones ministeriales generales.

      //- Contenedor de Acciones Unificado
      .d-flex.flex-wrap.align-items-center.gap-2
        a.btn.btn-outline-danger.shadow-sm.px-3.py-2.fw-semibold.rounded-3(href="/report/services")
          i.bi.bi-file-earmark-text.me-2
          | Vista Reporte

        a.btn.btn-action.shadow-sm.px-4.py-2.fw-semibold.rounded-3(href="/service/create")
          i.bi.bi-calendar-plus.me-2
          | Nuevo Servicio

    //- Gestión de Mensajes y Alertas Globales (Ancho completo adaptativo)
    include ../partials/_messages

    //- Contenedor Principal (Tabla optimizada para DataTables y Bento Design)
    .card.bento-card.border-0.shadow-sm.overflow-hidden(style="background: #ffffff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.03);")
      .card-body.p-4
        .table-responsive
          table.table.table-hover.align-middle.mb-0.tabla-institucional#tabla-cronograma-cultos
            thead
              tr
                th.ps-4.py-3(style="width: 80px; background-color: var(--ijersac-bg); color: var(--ijersac-navy);") ID
                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") FECHA Y HORA
                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") TIPO DE SERVICIO
                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") DIRIGENTE
                th.py-3(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") PREDICADOR
                th.pe-4.py-3.text-end(style="background-color: var(--ijersac-bg); color: var(--ijersac-navy);") ACCIONES

            tbody
              if cultos && cultos.length > 0
                each culto in cultos
                  tr
                    td.ps-4
                      span.id-badge.fw-bold(style="color: var(--ijersac-navy);") ##{culto.id_culto}

                    td
                      //- Tratamiento de fecha visual segura en UTC
                      - var f = culto.fecha ? new Date(culto.fecha).toLocaleDateString('es-ES', {timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'short'}) : 'No asignada' 
                      span.text-uppercase.d-block.fw-bold.txt-carmesi(style="font-size: 0.88rem;") #{f}
                      if culto.hora
                        - var [horas, minutos] = culto.hora.split(':')
                        - var fechaBase = new Date(2000, 0, 1, horas, minutos)
                        - var horaFormateada = fechaBase.toLocaleTimeString('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true })
                        span.text-muted.small.fw-semibold 
                          i.bi.bi-clock.me-1
                          | #{horaFormateada}
                      else
                        span.text-muted.small.fw-semibold Por definir

                    td
                      span.badge.badge-culto-tipo.text-uppercase.px-3.py-2.fw-bold #{culto.tipo_culto}

                    td
                      if culto.id_dirigente
                        span.small.text-dark.fw-medium
                          | #{culto.nombre_dirigente} #{culto.apellido_dirigente}
                      else if culto.dirigente_externo
                        span.small.text-muted.fw-semibold
                          | #{culto.dirigente_externo} 
                        span.badge.bg-light.text-secondary.ms-1.small (Invitado)
                      else
                        span.small.text-muted.fst-italic Sin asignar

                    td
                      if culto.id_predicador
                        span.small.text-dark.fw-medium
                          | #{culto.nombre_predicador} #{culto.apellido_predicador}
                      else if culto.predicador_externo
                        span.small.text-secondary.fw-semibold
                          | #{culto.predicador_externo} 
                        span.badge.bg-light.text-secondary.ms-1.small (Invitado)
                      else
                        span.small.text-muted.fst-italic Sin asignar

                    td.pe-4.text-end
                      .d-flex.justify-content-end.gap-2
                        a.btn.btn-sm.btn-accion-logistica.rounded-3(
                          href=`/logistic/manage/${culto.id_culto}` 
                          title="Gestionar Logística"
                        )
                          i.bi.bi-gear-fill

                        a.btn.btn-sm.btn-accion-editar.rounded-3(
                          href=`/service/update/${culto.id_culto}` 
                          title="Editar Servicio"
                        )
                          i.bi.bi-pencil-square

                        button.btn.btn-sm.btn-accion-eliminar.rounded-3.btn-delete-service(
                          type="button" 
                          title="Eliminar Servicio"
                          data-id=culto.id_culto
                          data-name=culto.tipo_culto
                          data-date=f
                        )
                          i.bi.bi-trash
              else
                tr
                  td.text-center.py-5.text-muted(colspan="6") 
                    i.bi.bi-calendar-x.d-block.fs-2.mb-2.text-black-50
                    | No hay reuniones agendadas en este momento.

block scripts
  style.
    /* Tipografías y textos específicos del módulo */
    .txt-carmesi {
      color: #dc3545;
    }

    /* Badge genérico para tipos de culto en tonos corporativos atenuados */
    .badge-culto-tipo {
      background-color: #f1f5f9 !important;
      color: var(--ijersac-navy) !important;
      border: 1px solid #e2e8f0 !important;
      font-size: 11px;
    }

    /* Micro-interacciones y diseño avanzado para la barra de acciones */
    .btn-accion-logistica {
      background-color: #f0f9ff;
      color: #0284c7;
      border: 1px solid #e0f2fe;
      transition: all 0.2s ease;
    }
    .btn-accion-logistica:hover {
      background-color: #0284c7;
      color: #ffffff;
    }

    .btn-accion-editar {
      background-color: #f8fafc;
      color: var(--ijersac-navy-light);
      border: 1px solid #e2e8f0;
      transition: all 0.2s ease;
    }
    .btn-accion-editar:hover {
      background-color: var(--ijersac-navy-light);
      color: #ffffff;
    }

    .btn-accion-eliminar {
      background-color: #fff1f2;
      color: #f43f5e;
      border: 1px solid #ffe4e6;
      transition: all 0.2s ease;
    }
    .btn-accion-eliminar:hover {
      background-color: #f43f5e;
      color: #ffffff;
    }

  //- Corrección en la ruta relativa del script del módulo de servicios
  script(src="/js/modules/service.js")