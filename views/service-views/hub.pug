extends ../layout

block styles
    style.
        .menu-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            text-decoration: none !important;
        }
        .menu-card:hover {
            transform: translateY(-5px);
            border-color: #dc3545;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04) !important;
        }
        .icon-container {
            width: 55px;
            height: 55px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

block content
    .container-fluid.px-3.px-md-4.py-4

        //- Encabezado del Módulo
        .mb-4.p-4.rounded-4(style="background: #ffffff; box-shadow: 0 4px 24px rgba(0,0,0,0.02);")
            h2.fw-bold.text-dark.mb-1 Módulo de Servicios de Culto
            p.text-muted.small.mb-0 Elige la herramienta de trabajo que necesitas utilizar en este momento.

        //- Grilla de Opciones en Tarjetas Inteligentes
        .row.g-4

            //- TARJETA 1: GESTIÓN (Tu index original de DataTables)
            if user && ['admin', 'lider'].includes(user.rol)
                .col-12.col-md-6
                    a.card.menu-card.h-100.p-4.shadow-sm(href="/service")
                        .d-flex.align-items-start.gap-3
                            .icon-container.bg-danger-subtle
                                i.bi.bi-table.fs-3.text-danger
                            .flex-grow-1
                                h5.fw-bold.text-dark.mb-1 Panel de Control e Historial
                                p.text-muted.small.mb-0 Accede al listado institucional en tablas, registra nuevos cultos, modifica asignaciones y genera reportes ministeriales.
                                span.btn.btn-sm.btn-light.mt-3.rounded-2.fw-semibold 
                                    | Abrir Tablas
                                    i.bi.bi-arrow-right.ms-2

            //- TARJETA 2: CRONOGRAMA INTERACTIVO (Modales/Calendario)
            if user && ['admin', 'lider', 'miembro'].includes(user.rol)
                .col-12.col-md-6
                    a.card.menu-card.h-100.p-4.shadow-sm(href="/service/schedule")
                        .d-flex.align-items-start.gap-3
                            .icon-container.bg-primary-subtle
                                i.bi.bi-calendar3.fs-3.text-primary
                            .flex-grow-1
                                h5.fw-bold.text-dark.mb-1 Calendario e Itinerario de Miembros
                                p.text-muted.small.mb-0 Explora de forma interactiva la agenda cronológica de cultos, consulta horarios y visualiza tus turnos mediante el buscador por mes.
                                span.btn.btn-sm.btn-light.mt-3.rounded-2.fw-semibold 
                                    | Ver Calendario
                                    i.bi.bi-arrow-right.ms-2