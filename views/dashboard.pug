extends layout

block content
  //- Header del Dashboard
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h4.fw-bold.text-dark.mb-1 Panel de Control Administrativo
      p.text-muted.small Gestión integral y logística operativa de la congregación IJERSAC
    .d-flex.gap-2
      button.btn.btn-white.border.shadow-sm.btn-sm
        i.bi.bi-download.me-2
        | Reporte PDF
      button.btn.btn-dark.shadow-sm.btn-sm
        i.bi.bi-plus-lg.me-2
        | Nuevo Registro

  //- 🍱 MÁSTER BENTO GRID SYSTEM
  .row.g-4
    
    //- Bloque 1: Gráfico de Crecimiento (Grande - Ocupa 8 columnas en pantallas grandes)
    .col-xl-8.col-lg-7
      .card.border-0.shadow-sm.h-100.bento-card
        .card-header.bg-transparent.border-0.p-4.pb-0
          .d-flex.justify-content-between.align-items-center
            div
              h6.fw-bold.text-dark.mb-1 Análisis de Crecimiento
              p.text-muted.x-small Tendencia de nuevos ingresos anuales consolidada
            select.form-select.form-select-sm.border-light.shadow-none.bg-light(style="width: 100px;")
              option(selected) 2026
              option 2025
        .card-body.px-4.pb-4.pt-2
          div(style="height: 310px; position: relative;")
            canvas#growthChart

    //- Bloque 2: Módulo de Métricas 
    .col-xl-4.col-lg-5
      .row.g-3.h-100
        - 
          const metrics = [
            { label: 'Total Usuarios', value: '1,520', sub: '+8.5% este mes', color: 'primary', icon: 'bi-people' },
            { label: 'Activos', value: '1,405', sub: '92% de la membresía', color: 'success', icon: 'bi-person-check' },
            { label: 'Inactivos', value: '115', sub: 'Requieren atención', color: 'danger', icon: 'bi-person-x' },
            { label: 'Crecimiento', value: '+12%', sub: 'Promedio mensual', color: 'warning', icon: 'bi-graph-up-arrow' }
          ]
        
        each item in metrics
          .col-6
            .card.border-0.shadow-sm.h-100.bento-card.p-2
              .card-body.p-3.d-flex.flex-column.justify-content-between
                .d-flex.justify-content-between.align-items-center.mb-2
                  .icon-box.rounded-3(class=`bg-${item.color}-subtle text-${item.color}`)
                    i.bi(class=item.icon)
                div
                  span.text-muted.x-small.fw-bold.text-uppercase.ls-1= item.label
                  h3.fw-bold.text-dark.my-1= item.value
                  span.d-block.text-muted.xx-small.fw-medium= item.sub

    //- Bloque 3: Usuarios Recientes 
    .col-xl-5.col-lg-6
      .card.border-0.shadow-sm.h-100.bento-card
        .card-header.bg-transparent.border-0.p-4.pb-0
          .d-flex.justify-content-between.align-items-center
            div
              h6.fw-bold.text-dark.mb-0 Usuarios Recientes
              p.text-muted.x-small Altas registradas en los últimos 7 días
            span.badge.bg-dark.text-white.px-2.py-1.xx-small Operativo
        .card-body.p-4.pt-2
          .table-responsive
            table.table.table-hover.align-middle.mb-0
              tbody
                - const users = [{n:'Ana María Gómez', m:'Comité Niños', b:'002855'}, {n:'Pedro Soto', m:'Ministerio Alabanza', b:'D4AF37'}, {n:'Lucía Rivas', m:'Escuela Dominical', b:'003a7a'}]
                each user in users
                  tr
                    td.ps-0(style="width: 50px;")
                      img.rounded-circle(src=`https://ui-avatars.com/api/?name=${user.n.replace(/ /g, '+')}&background=${user.b}&color=fff` width="38")
                    td
                      div.fw-bold.text-dark.small-text= user.n
                      div.text-muted.xx-small= user.m
                    td.text-end.pe-0
                      button.btn.btn-light.btn-xs.rounded-circle
                        i.bi.bi-arrow-right-short

    //- Bloque 4: Próximos Eventos y Agenda (Ocupa 7 columnas para balancear)
    .col-xl-7.col-lg-6
      .card.border-0.shadow-sm.h-100.bento-card
        .card-header.bg-transparent.border-0.p-4.pb-0
          .d-flex.justify-content-between.align-items-center
            div
              h6.fw-bold.text-dark.mb-0 Calendario de Próximos Eventos
              p.text-muted.x-small Planificación de cultos y reuniones
            a.text-dark.text-decoration-none.xx-small.fw-bold.border-bottom.border-dark(href="#") Ver Agenda
        .card-body.p-4.pt-2
          .row.g-3
            each event in [{d:'15', m:'JUN', t:'Culto Especial de Adoración', s:'Confirmado', c:'success'}, {d:'22', m:'JUN', t:'Reunión General de Logística', s:'Pendiente', c:'warning'}]
              .col-12
                .p-3.rounded-3.border.d-flex.align-items-center.bg-light.bg-opacity-40.event-row
                  .date-badge.me-3.text-center.bg-white.shadow-sm.rounded-3.p-2(style="min-width: 55px;")
                    span.d-block.fw-bold.text-dark.h5.mb-0= event.d
                    span.d-block.text-muted.xx-small.fw-bold= event.m
                  .flex-grow-1
                    h6.mb-1.fw-bold.text-dark.small-text= event.t
                    small.text-muted.xx-small
                      i.bi.bi-geo-alt.me-1
                      | Auditorio Central SAIC
                  span.badge.border.xx-small(class=`bg-${event.c}-subtle text-${event.c} border-${event.c}-subtle`) #{event.s}

block scripts
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script(src="/js/charts-dashboard.js")
  
  