extends ../layout

block styles
    link(rel="stylesheet" href="/css/tablas-institucionales.css")

block content
    //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
    .container-fluid.px-4.py-4

        //- ==========================================
        //- ENCABEZADO DE CONTEXTO ASIMÉTRICO (BENTO)
        //- ==========================================
        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4.p-4.rounded-4(style="background: var(--bg-surface); box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle);")
            div
                span.badge.text-uppercase.fw-bold(style="background-color: var(--calm-green-primary, #e0f2fe); font-size: 0.72rem; letter-spacing: 0.5px;") Tesorería General
                h2.fw-bold.text-dark.mb-1.mt-1 Gestión de Donaciones
                p.text-muted.mb-0(style="font-size: 0.78rem;") Supervise los ingresos, flujos de caja y auditorías contables del sistema (SAIC).

            a.btn.btn-premium.shadow-sm.px-4.py-2.fw-bold.rounded-3.d-inline-flex.align-items-center(href="/finance/create")
                i.bi.bi-plus-circle-fill.me-2
                | Nueva Donación

        //- Gestión de Mensajes, Alertas y Auditoría Global de Operaciones
        include ../partials/_messages

        //- ==========================================
        //- GRID BENTO DE HISTORIAL FINANCIERO
        //- ==========================================
        .row
            .col-12
                .card.bento-card.border-0.p-4(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")
                    .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3.mb-4
                        h4.fw-bold.text-dark.m-0 
                            i.bi.bi-clock-history.me-2(style="color: var(--calm-green-primary);")
                            | Transacciones Registradas
                        span.badge.text-secondary.border.px-3.py-2.fw-semibold(style="border-color: var(--border-subtle) !important; background-color: var(--bg-app); font-size: 0.75rem;") Divisa Base: COP ($)

                    .table-responsive
                        table.table.table-hover.align-middle.mb-0.tabla-institucional#tabla-donaciones
                            thead
                                tr(style="border-bottom: 2px solid var(--border-subtle);")
                                    th.text-secondary.fw-bold(style="font-size: 0.72rem;") Fecha
                                    th.text-secondary.fw-bold(style="font-size: 0.72rem;") Aportante
                                    th.text-secondary.fw-bold(style="font-size: 0.72rem;") Categoría
                                    th.text-secondary.fw-bold(style="font-size: 0.72rem;") Monto
                                    th.text-secondary.fw-bold.text-center(style="font-size: 0.72rem;") Estado
                                    th.text-secondary.fw-bold.text-center(style="font-size: 0.72rem;") Acción
                            tbody
                                if donaciones && donaciones.length > 0
                                    each donacion in donaciones
                                        - var isAnulada = donacion.estado === 'Anulada'
                                        tr(style=isAnulada ? 'opacity: 0.45; background-color: var(--bg-app); text-decoration: line-through;' : '')

                                            //- Fecha de Registro
                                            td.fw-semibold.text-dark(style="font-size: 0.82rem;")
                                                = new Date(donacion.fecha_registro).toLocaleDateString('es-CO', {timeZone: 'UTC', year: 'numeric', month: '2-digit', day: '2-digit'})

                                            //- Datos del Aportante (Miembro o Externo)
                                            td
                                                if donacion.nombre_miembro
                                                    - var aportante = donacion.nombre_miembro
                                                    span.text-dark.fw-semibold(style="font-size: 0.82rem;") 
                                                        i.bi.bi-person-fill.text-muted.me-2
                                                        | #{donacion.nombre_miembro}
                                                else
                                                    - var aportante = donacion.nombre_externo
                                                    span.text-muted.fst-italic(style="font-size: 0.82rem;") 
                                                        i.bi.bi-globe.text-muted.me-2
                                                        | #{donacion.nombre_externo} (Externo)

                                            //- Categoría del Ingreso
                                            td
                                                span.badge.text-secondary.border.px-2.py-1(style="font-size: 0.72rem; background-color: var(--bg-app); border-color: var(--border-subtle) !important;")= donacion.categoria_ingreso

                                            //- Monto Monetario Formateado
                                            td.fw-bold.text-dark.fw-mono(style="font-size: 0.85rem;")
                                                | $#{parseFloat(donacion.monto).toLocaleString('es-CO', { minimumFractionDigits: 0 })}

                                            //- Estado de la Transacción
                                            td.text-center
                                                if donacion.estado === 'Asentada'
                                                    span.badge.px-2.py-1.rounded-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary); font-weight: 600; font-size: 0.75rem;") Asentada
                                                else
                                                    span.badge.px-2.py-1.rounded-3(style="background-color: var(--danger-subtle, #fde8e8); color: var(--danger-primary, #c81e1e); font-weight: 600; font-size: 0.75rem;") Anulada

                                            //- Acciones de Control / Auditoría
                                            td.text-center
                                                if donacion.estado === 'Asentada'
                                                    // Formulario de anulación en background para uso del script del módulo
                                                    form(id=`cancel-form-${donacion.id_donacion}` action=`/finance/donations/cancel/${donacion.id_donacion}` method="POST" style="display:none;")

                                                    button.btn.btn-link.text-danger.p-0.m-0.border-0(
                                                        type="button" 
                                                        title="Anular Transacción" 
                                                        onclick=`confirmarAnulacion('${donacion.id_donacion}', '${aportante}', '${parseFloat(donacion.monto).toLocaleString("es-CO")}')`
                                                        style="background: none;"
                                                    )
                                                        i.bi.bi-trash3-fill.fs-6
                                                else
                                                    button.btn.btn-link.text-muted.p-0.m-0.disabled.border-0(type="button" disabled style="background: none;")
                                                        i.bi.bi-dash-circle-fill.fs-6
                                else
                                    tr
                                        td.text-center.text-muted.py-5(colspan="6")
                                            i.bi.bi-cash-stack.display-6.text-black-50.d-block.mb-2
                                            h6.fw-bold.mb-1 Sin registros de caja
                                            p.text-muted.mb-0(style="font-size: 0.72rem;") No se han detectado asientos financieros asentados en el sistema todavía.

block scripts
    script(src="/js/modules/finance-donacion.js")
    style.
        .fw-mono { font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        .bento-card { transition: transform 0.2s ease, border-color 0.2s ease; }
        .bento-card:hover { border-color: var(--calm-green-primary) !important; }