extends ../layout

block content
    //- Contenedor raíz adaptado al estándar de grilla expandida de SAIC
    .container-fluid.px-4.py-4

        //- 🚀 ENCABEZADO ESTÁNDAR GLOBAL (Centrado y equilibrado con el formulario)
        +formHeader(
            'Registrar Ingreso Financiero', 
            '/finance', 
            [
                { text: 'SAIC', link: '/dashboard', active: false },
                { text: 'Finanzas', link: '/finance', active: false },
                { text: 'Asentar Donación', active: true }
            ]
        )

        //- CONTENIDO DE FORMULARIO 
        .row.justify-content-center
            .col-12.col-lg-10.col-xl-8

                //- Gestión de Mensajes y Alertas Globales de Validación Financiera
                include ../partials/_messages

                //- Tarjeta Bento Contenedora del Formulario
                .card.bento-card.p-4.mb-4.border-0(style="background: var(--bg-surface); border-radius: 16px; box-shadow: var(--shadow-bento); border: 1px solid var(--border-subtle) !important;")

                    // Encabezado interno con toque verde esmeralda institucional
                    .d-flex.align-items-center.mb-4
                        .p-2.rounded-3.me-3(style="background-color: var(--calm-green-subtle); color: var(--calm-green-primary);")
                            i.bi.bi-piggy-bank-fill.fs-4
                        div
                            h4.fw-bold.text-dark.m-0 Comprobante de Ingreso
                            p.text-muted.mb-0(style="font-size: 0.78rem;") Ingrese los datos fiscales y contables de la transacción.

                    form(action="/finance/donations/create" method="POST")

                        // Conmutador de Procedencia Estilizado con fondo sutil del sistema
                        .mb-4.p-3.rounded-3(style="background-color: var(--bg-app); border: 1px solid var(--border-subtle);")
                            label.form-label.fw-bold.text-secondary.text-uppercase.mb-2(style="font-size: 0.72rem; letter-spacing: 0.5px;") Procedencia del Fondo
                            .d-flex.gap-4.mt-1
                                .form-check
                                    input#proc_interno.form-check-input(type="radio" name="procedencia" value="interno" checked=(valores.procedencia !== 'externo') onchange="toggleFormFields()")
                                    label.form-check-label.fw-semibold.text-dark(for="proc_interno" style="font-size: 0.85rem;") Miembro Institucional
                                .form-check
                                    input#proc_externo.form-check-input(type="radio" name="procedencia" value="externo" checked=(valores.procedencia === 'externo') onchange="toggleFormFields()")
                                    label.form-check-label.fw-semibold.text-dark(for="proc_externo" style="font-size: 0.85rem;") Donante Externo / Tercero

                        // Grupo Dinámico 1: Selección de Miembros (Interno)
                        #group_interno.mb-4
                            label.form-label.fw-semibold.text-secondary(for="id_miembro" style="font-size: 0.82rem;") 
                                i.bi.bi-person-badge.me-2
                                | Seleccionar Miembro Activo
                            select#id_miembro.form-select.form-select-lg.rounded-3(name="id_miembro" style="border-color: var(--border-subtle); font-size: 0.88rem;")
                                option(value="") -- Seleccione una persona del listado --
                                if miembros && miembros.length > 0
                                    each miembro in miembros
                                        option(value=miembro.id_miembro selected=(valores.id_miembro == miembro.id_miembro))= `${miembro.apellido}, ${miembro.nombre}`

                        // Grupo Dinámico 2: Datos de Contacto (Externo)
                        #group_externo.d-none
                            .mb-3
                                label.form-label.fw-semibold.text-secondary(for="nombre_externo" style="font-size: 0.82rem;") 
                                    i.bi.bi-building.me-2
                                    | Nombre Completo / Razón Social
                                input#nombre_externo.form-control.rounded-3(type="text" name="nombre_externo" placeholder="Ej: Juan Pérez o Empresa X" value=valores.nombre_externo style="border-color: var(--border-subtle); font-size: 0.88rem;")
                            .row.g-3
                                .col-md-6
                                    label.form-label.fw-semibold.text-secondary(for="telefono_externo" style="font-size: 0.82rem;") Teléfono de Contacto
                                    input#telefono_externo.form-control.rounded-3(type="text" name="telefono_externo" placeholder="Opcional" value=valores.telefono_externo style="border-color: var(--border-subtle); font-size: 0.88rem;")
                                .col-md-6
                                    label.form-label.fw-semibold.text-secondary(for="correo_externo" style="font-size: 0.82rem;") Correo Electrónico
                                    input#correo_externo.form-control.rounded-3(type="email" name="correo_externo" placeholder="Opcional" value=valores.correo_externo style="border-color: var(--border-subtle); font-size: 0.88rem;")

                        hr.my-4(style="color: var(--border-subtle);")

                        // Datos Generales de la Donación
                        .row.g-3.mb-4
                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="monto" style="font-size: 0.82rem;") Valor del Ingreso ($ COP)
                                .input-group.input-group-lg
                                    span.input-group-text.border-end-0.fw-bold.text-muted(style="background-color: var(--bg-app); border-color: var(--border-subtle); font-size: 0.88rem;") $
                                    input#monto.form-control.border-start-0.fw-bold.text-dark(type="text" name="monto" placeholder="Ej: 50.000" required value=valores.monto || '' style="border-color: var(--border-subtle); font-size: 1.1rem;")
                                // Advertencia sutil adaptada a la paleta de alertas destructivas de SAIC
                                small.form-text.d-block.mt-1(style="color: var(--danger-primary, #ef4444); font-weight: 500; font-size: 0.75rem;")
                                    i.bi.bi-info-circle-fill.me-1
                                    | Formato nacional: usa puntos para miles (Ej: 5.000).

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="fecha" style="font-size: 0.82rem;") Fecha de Recaudo
                                input#fecha.form-control.form-control-lg.rounded-3(type="date" name="fecha" required value=valores.fecha || new Date().toISOString().split('T')[0] style="border-color: var(--border-subtle); font-size: 0.88rem;")

                        .row.g-3.mb-4
                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="tipo_pago" style="font-size: 0.82rem;") Canal / Método de Pago
                                select#tipo_pago.form-select.form-select-lg.rounded-3(name="tipo_pago" style="border-color: var(--border-subtle); font-size: 0.88rem;" required)
                                    option(value="Efectivo" selected=(valores.tipo_pago === 'Efectivo')) Efectivo
                                    option(value="Transferencia" selected=(valores.tipo_pago === 'Transferencia')) Transferencia
                                    option(value="Consignación" selected=(valores.tipo_pago === 'Consignación')) Consignación
                                    option(value="Cheque" selected=(valores.tipo_pago === 'Cheque')) Cheque

                            .col-md-6
                                label.form-label.fw-semibold.text-secondary(for="categoria_ingreso" style="font-size: 0.82rem;") Destino / Categoría Contable
                                select#categoria_ingreso.form-select.form-select-lg.rounded-3(name="categoria_ingreso" style="border-color: var(--border-subtle); font-size: 0.88rem;" required)
                                    option(value="Ofrenda General" selected=(valores.categoria_ingreso === 'Ofrenda General')) Ofrenda General
                                    option(value="Diezmo" selected=(valores.categoria_ingreso === 'Diezmo')) Diezmo
                                    option(value="Donación Especial" selected=(valores.categoria_ingreso === 'Donación Especial')) Donación Especial
                                    option(value="Pro-Templo" selected=(valores.categoria_ingreso === 'Pro-Templo')) Pro-Templo

                        .mb-4
                            label.form-label.fw-semibold.text-secondary(for="observacion" style="font-size: 0.82rem;") Observaciones o Concepto
                            textarea#observacion.form-control.rounded-3(name="observacion" rows="3" placeholder="Detalle interno aclaratorio sobre el recaudo..." style="resize: none; border-color: var(--border-subtle); font-size: 0.88rem;")= valores.observacion

                        //- 🛠️ BOTONERA DE ACCIÓN SINCRONIZADA CON COMPONENTS.CSS
                        .d-flex.gap-3.pt-2
                            a.btn-light-custom.w-25(href="/finance") Cancelar

                            button.btn-premium.flex-grow-1(type="submit")
                                i.bi.bi-cloud-arrow-up-fill.me-2
                                | Asentar Registro Diario

block scripts
    script.
        function toggleFormFields() {
            const isInterno = document.getElementById('proc_interno').checked;
            const groupInterno = document.getElementById('group_interno');
            const groupExterno = document.getElementById('group_externo');
            const selectMiembro = document.getElementById('id_miembro');
            const inputNombreExterno = document.getElementById('nombre_externo');

            if (isInterno) {
                groupInterno.classList.remove('d-none');
                groupExterno.classList.add('d-none');
                selectMiembro.setAttribute('required', 'required');
                inputNombreExterno.removeAttribute('required');
            } else {
                groupInterno.classList.add('d-none');
                groupExterno.classList.remove('d-none');
                selectMiembro.removeAttribute('required');
                inputNombreExterno.setAttribute('required', 'required');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            toggleFormFields();
        });